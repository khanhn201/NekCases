[GENERAL]
startFrom="c1.f00000"
numSteps = 100000
dt = 2e-4
# timeStepper = tombo2
writeInterval = 250

filtering = hpfrt
filterModes = 2
filterWeight = 10.0


[PROBLEMTYPE]
# equation = navierStokes+variableViscosity
# variableProperties = yes
# stressFormulation = yes

[PRESSURE]
residualTol = 1e-6
residualProj = yes

[VELOCITY]
residualTol = 1e-8
density = 1.0
viscosity = -250

[TEMPERATURE]
solver = none
