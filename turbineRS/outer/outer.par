[GENERAL]
polynomialOrder = 7
#startFrom = "restart.fld"
numSteps = 10000
dt = 5e-6
timeStepper = tombo2
writeInterval = 500
udf = "../turbine.udf"
#startFrom = "./outer0.f00020"

# regularization = hpfrt + nModes=2 + scalingCoeff=10

[NEKNEK]
boundaryEXTOrder = 1

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
residualTol = 1e-6
density = 1.0
viscosity = 1/5000
boundaryTypeMap = interpolation, zeroGradient, codedFixedValue, zeroValue

[MESH]
solver=user
file = "outer.re2"

[SCALAR00]
solver = none

[CASEDATA]
P_OMEGA = 0.0
