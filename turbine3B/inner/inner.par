[GENERAL]
polynomialOrder = 9
#startFrom = "restart.fld"
numSteps = 50000
dt = 5e-5
subCyclingSteps = 2
timeStepper = tombo2
writeInterval = 1000
#udf = "../turbine.udf"
#startFrom = "./inner0.f00020"
startFrom = "./innergeo.f00000"

regularization = hpfrt + nModes=1 + scalingCoeff=10

[NEKNEK]
boundaryEXTOrder = 1

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
residualTol = 1e-6
density = 1.0
viscosity = 1/50000
boundaryTypeMap = interpolation, codedFixedValue
solver=pcg+block

[MESH]
solver=user
file = "inner.re2"

[SCALAR00]
solver = none

[CASEDATA]
# P_OMEGA = 0.375
P_OMEGA = 0.110
# P_OMEGA = 0.0
processAscentYamlFrequency = 1000
