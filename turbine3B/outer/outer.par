[GENERAL]
polynomialOrder = 9
#startFrom = "restart.fld"
numSteps = 200000
dt = 1e-5
subCyclingSteps = 2
timeStepper = tombo2
writeInterval = 5000
#startFrom = "./outer0.f00031"
#startFrom = "./outergeo.f00000"
startFrom = "./outerc1.f00000"

udf = "../turbine.udf"

regularization = hpfrt + nModes=1 + scalingCoeff=10

[NEKNEK]
boundaryEXTOrder = 1
ascentUseGlobalComm = true

[PRESSURE]
residualTol = 1e-04
#coarsegriddiscretization = galerkin

[VELOCITY]
residualTol = 1e-6
density = 1.0
viscosity = 1/50000
boundaryTypeMap = interpolation, zeroGradient, codedFixedValue, zeroValue
solver=pcg+block

[MESH]
solver=user
#refine=2
file = "outer.re2"

[SCALAR00]
solver = none

[CASEDATA]
P_OMEGA = 0.110
processAscentYamlFrequency = 5000
turbine_session = 2
