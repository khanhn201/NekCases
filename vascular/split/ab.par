[GENERAL]
numSteps = 1000
dt = 1e-2
# timeStepper = tombo2
writeInterval = 10

filtering = hpfrt
filterModes = 2
filterWeight = 10.0

[PROBLEMTYPE]
# equation = navierStokes+variableViscosity
variableProperties = yes

[PRESSURE]
residualTol = 1e-8

[VELOCITY]
residualTol = 1e-8
density = 1.0
viscosity = 4/500
