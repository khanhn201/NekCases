      include "experimental/lvlSet.f"
      include "lineplot.f"
      include "experimental/lserrors.f"
c-----------------------------------------------------------------------
      subroutine spline(x,y,n,y2)
      parameter (nmax=100)
      dimension x(n),y(n),y2(n),u(nmax)
      if (n.gt.nmax) then
         write(6,11) n,nmax
   11    FORMAT(2X,'ERROR:  Attempt to fit a spline with',I5
     $            ,'greater than',I4,' points.'
     $       ,/,2X,'Recompile routine SPLINE.')
         call exitti('routine spline fail$',n)
      endif
      y2(1)=0.0
      u(1) =0.0
      do 10 i=2,n-1
         ir=i+1
         il=i-1
         sig=(x(i)-x(il))/(x(ir)-x(il))
         p=sig*y2(il)+2.
         y2(i)=(sig-1.)/p
         u(i)= ( 6.*
     $     ( (y(ir)-y(i))/(x(ir)-x(i))-(y(i)-y(il))/ (x(i)-x(il) ) )
     $            / (x(ir)-x(il))
     $    - sig*u(il) )/p
   10 continue
      qn=0.0
      un=0.0
      y2(n)=(un-qn*u(n-1))/(qn*y2(n-1)+1.)
      do 20 k=n-1,1,-1
         y2(k)=y2(k)*y2(k+1)+u(k)
   20 continue
      return
      end
c-----------------------------------------------------------------------
      subroutine splint(xa,ya,y2a,n,x,y)
c     p. 88-89, numerical recipes
      real xa(n),ya(n),y2a(n)
      klo=1
      khi=n
    1   if ((khi-klo).gt.1) then
           k=(khi+klo)/2
           if (xa(k).gt.x) then
              khi=k
           else
              klo=k
           endif
           goto 1
        endif
      h=xa(khi)-xa(klo)
      if (h.eq.0) then
         write(6,*) xa(khi), 'splint failure',khi
         return
      endif
      a=(xa(khi)-x)/h
      b=(x-xa(klo))/h
      y=a*ya(klo)+b*ya(khi)+
     $  ((a**3-a)*y2a(klo)+(b**3-b)*y2a(khi))*(h**2)/6.
      return
      end
c-----------------------------------------------------------------------
      function blasius(y,delta,u)
c     Return the velocity at a given y value for specified delta and U.
      integer icalld
      save    icalld
      data    icalld /0/
      dimension u0(45),y0(45),work(45)
      save      u0    ,y0    ,work
      data      u0 / 0.00000 , 0.06641 , 0.13277 , 0.19894 , 0.26471
     $             , 0.32979 , 0.39378 , 0.45627 , 0.51676 , 0.57477
     $             , 0.62977 , 0.68132 , 0.72899 , 0.77246 , 0.81152
     $             , 0.84605 , 0.87609 , 0.90177 , 0.92333 , 0.94112
     $             , 0.95552 , 0.96696 , 0.97587 , 0.98269 , 0.98779
     $             , 0.99155 , 0.99425 , 0.99616 , 0.99748 , 0.99838
     $             , 0.99898 , 0.99937 , 0.99961 , 0.99977 , 0.99987
     $             , 0.99992 , 0.99996 , 0.99998 , 0.99999 , 1.00000
     $             , 1.00000 , 1.00000 , 1.00000 , 1.00000 , 1.00000 /
      if (icalld.eq.0) then
c        Initialize Blasius profile and spline fitting routine.
         icalld=1
         do 10 i=1,45
            y0(i)=float(i-1)/5.0
   10    continue
         call spline(y0,u0,45,work)
      endif
      eta=5.0*y/delta
      if (eta.gt.8.5) then
         blasius=u
      else
         call splint(y0,u0,work,45,eta,vel)
         blasius=vel*u
      endif
      return
      end
c-----------------------------------------------------------------------
      subroutine surface_flux_scal(dq,scal,qx,qy,qz,e,f,w,w2)

      include 'SIZE'
      include 'TOTAL'
      parameter (l=lx1*ly1*lz1)

      real scal(l,1),qx(l,1),qy(l,1),qz(l,1),w(lx1,ly1,lz1),w2(l)
      real scal_pos(l)      ! Temporary copy
      real scal_p
      integer e,f

      do i = 1,l
         scal_p = scal(i,e)
         if (scal_p.gt.0.5) then
           scal_pos(i) = 1.0
         else
           scal_pos(i) = 0.0
         endif
      enddo

      call col3    (w2,scal_pos,qx(1,e),l)
      call faccl3  (w,w2,unx(1,1,f,e),f)

      call col3    (w2,scal_pos,qy(1,e),l)
      call faddcl3 (w,w2,uny(1,1,f,e),f)

      if (ldim.gt.2) then
         call col3    (w2,scal_pos,qz(1,e),l)
         call faddcl3 (w,w2,unz(1,1,f,e),f)
      endif

      call dsset(lx1,ly1,lz1)
      iface  = eface1(f)
      js1    = skpdat(1,iface)
      jf1    = skpdat(2,iface)
      jskip1 = skpdat(3,iface)
      js2    = skpdat(4,iface)
      jf2    = skpdat(5,iface)
      jskip2 = skpdat(6,iface)

      dq = 0
      i  = 0
      do 100 j2=js2,jf2,jskip2
      do 100 j1=js1,jf1,jskip1
         i = i+1
         dq    = dq + area(i,1,f,e)*w(j1,j2,1)
  100 continue

      return
      end
c-----------------------------------------------------------------------
      subroutine uservp(ix,iy,iz,eg) ! set variable properties
      implicit none
      integer ix,iy,iz,eg,e
     
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      real Re, We, Fr, rhoratio, muratio
      real udim, charl, rhol, mul, gdim, gamm
      real nul, nug
      real rhog,mug
      real psi
      integer icalld
      save icalld
      data icalld /0/

      common /dimen/ Re,We,Fr

      e = gllel(eg)

!     These routine is not called by external solver
!     To Do: change the flow, so that this routine is called
!     similar to RANS. Will avoid confusion

      charl = 0.05715
      gdim = 9.81
      rhol = 1000.0
      rhog = 1.2
      mul = 1e-3
      mug = 1.8e-5 !/5.0
      nul = mul/rhol
      nug = mug/rhog
      charl = 0.05715

      !https://www.sciencedirect.com/science/article/pii/S0021999197958472
      udim = sqrt(gdim*charl)

      Re = rhol*udim*charl/mul
      Fr = udim**2.0/(gdim*charl)
      gamm = 0.06
      We = charl*rhol*udim**2.0/gamm

      if(ifield.eq.1)then
        psi = t(ix,iy,iz,e,ifld_cls-1)
        psi = max(0.0,psi)
        psi = min(1.0,psi)
        utrans = ((1.0-psi)*rhog + psi*rhol)/rhol
        udiff = ((1.0-psi)*mug + psi*mul)/mul/Re
        if(istep.le.2)then
          vtrans0(ix,iy,iz,e) = utrans
        else
          vtrans0(ix,iy,iz,e) = rhog/rhol
        endif
      else
        utrans = 1.0
        udiff = 1e-10
        if(ifavm(ifield-1))then
          udiff = 1e-10       !must be tiny for hyperbolic
        elseif(ifsvv(ifield-1))then
          udiff = 1e-10      !must be tiny for hyperbolic
        endif
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg) ! set acceleration term
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /dimen/ Re,We,Fr
      real Re,We,Fr
      real sfx,sfy,sfz

      real svvx,svvy,svvz

      e = gllel(eg)

      sfx = 0.0
      sfy = 0.0
      sfz = 0.0
      svvx = 0.0
      svvy = 0.0
      svvz = 0.0

      call surfacetension(ix,iy,iz,e,1./We,sfx,sfy,sfz)
c     call surfacetension(ix,iy,iz,e,0.0,sfx,sfy,sfz)
      
      call svv_fluid(ix,iy,iz,e,svvx,svvy,svvz)

      ffx = sfx + svvx
      ffy = sfy -1./Fr + svvy
c     ffz = sfz + svvz

      return
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,eg) ! set source term
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr
      real signls

      e = gllel(eg)
      
      qvol = 0.0
      avol = 0.0

      call limit_cls(ix,iy,iz,e)

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,eg) ! set up boundary conditions
      implicit none
      integer ix,iy,iz,iside,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      common /hydr_usr/ outflow_height
      real outflow_height

      integer e
      real yplus
      real xx,yy,heaviside
      real y_height
      real blasius

      e = gllel(eg)

      xx = xm1(ix,iy,iz,e)
      yy = ym1(ix,iy,iz,e)

      ux   = 0.0
      uy   = 0.0
      uz   = 0.0

      if (yy.le.1.0) then
        ux   = 1.5
      else
        ux = 1.5 - blasius(yy-1.0,0.13,1.5)
        ux = 1.5
      endif

      y_height = outflow_height
      if (xx.lt.1.0) then
        y_height = 1.0
      endif
      temp = y_height - yy
      if(ifield.eq.ifld_tls .or. ifield.eq.ifld_tlsr)then
        continue
      elseif(ifield.eq.ifld_cls .or. ifield.eq.ifld_clsr)then
        temp = heaviside(ix,iy,iz,e,temp,0.0)
      endif
      pa  = 0.0
c     if (temp.ge.0) then 
c       pa   = temp*9.81
c     endif


      return
      end
c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      common /hydr_usr/ outflow_height
      real outflow_height
      real blasius

      real xx,yy, x_max,heaviside
      real h_local, v_local
      real phix, phiy

      common /bump_usr/ A,H,W
      real A,H,W,argx, bump

      e = gllel(eg)

      xx = xm1(ix,iy,iz,e)
      yy = ym1(ix,iy,iz,e)

      argx = (xx - A)/W
      bump = H * exp(-argx*argx)

      h_local = 1.0 + bump
      h_local = 1.0
c     if (xx.ge.A) then
c       h_local = 1.0 - H + bump
c     endif

      outflow_height = 1.0

      ux = 0.0
      uy = 0.0
      uz = 0.0

      temp = h_local - yy

      if(ifield.eq.ifld_tls .or. ifield.eq.ifld_tlsr)then
        continue
      elseif(ifield.eq.ifld_cls .or. ifield.eq.ifld_clsr)then
        temp = heaviside(ix,iy,iz,e,temp,0.0)
      endif
      v_local = 1.5/(h_local-bump)
c     if (xx.ge.A) then
c       v_local = 1.5/(1.0-H)
c     endif
      if (temp.ge.0.0) then
        ux = v_local
      else
        ux = v_local - blasius(yy - h_local, 0.13, v_local)
        ux = v_local
      endif
      
c     phix = 1.0 - xx
c     phiy = 1.0 - yy
c     temp = min(phix,phiy)
      
      return
      end
c-----------------------------------------------------------------------
      subroutine userchk()
      implicit none
      include 'SIZE'
      include 'TOTAL'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      common /hydr_usr/ outflow_height
      real outflow_height

      real ntlsr, nclsr
      real pta(3),ptb(3)

      integer ntot,i

      real exact(lx1*ly1*lz1*lelv)
      save exact
      real psiini(lx1,ly1,lz1,lelv)
      save psiini
      real err
      
      real ls_volerr

      COMMON /SCRNS/ DVC  (LX1,LY1,LZ1,LELV),
     $               DV1  (LX1,LY1,LZ1,LELV),
     $               DV2  (LX1,LY1,LZ1,LELV),
     $               DFC  (LX1,LY1,LZ1,LELV)
      real DVC,DV1,DV2,DFC
      real DIV1, DIV2
      real glsum
      real fplot,fplot_next
      save fplot_next
      data fplot_next /0.0/
      integer pord
      integer ncut
      real starttime
      save starttime

      integer nface, f, e
      real w(lx1*ly1*lz1),w2(lx1*ly1*lz1)
      real total_flux, dq

      ntot = lx1*ly1*lz1*nelv



      total_flux = 0.0
      nface = 2*ldim
      do e=1,nelt
      do f=1,nface
         if (cbc(f,e,1).eq.'o  ') then ! Velocity outflow
            call surface_flux_scal(dq,t,vx,vy,vz,e,f,w,w2)
            total_flux = total_flux + dq
         endif
      enddo
      enddo
      total_flux = glsum(total_flux,1)
      outflow_height = outflow_height/(total_flux/1.5)
      if(nio.eq.0)then 
        write(*,*)"outflow_height",outflow_height
      endif
      




      if(istep.eq.0)then
        call copy(psiini,t(1,1,1,1,ifld_cls-1),ntot)
        call copy(exact,t(1,1,1,1,ifld_tls-1),ntot)
        do i=1,ntot
          if(exact(i).ge.0.0)then
            exact(i) = 1.0
          else
            exact(i) = 0.0
          endif
        enddo
      endif
      if(istep.eq.0 .and. nio.eq.0)then
        open(unit=100,file='vol.dat',status='unknown')
      endif

      pord = uparam(3)
      call extrappr(prext,pr,prlag(1,1,1,1,1),prlag(1,1,1,1,2),pord)
      ncut = lx1-1
      if(pord.ne.1) call cut_off_filter(prext,ncut,1)

      ntlsr = uparam(1) !freq of TLS re-distancing
      nclsr = uparam(2) !freq of CLS re-distancing

      call LS_default_driver(ntlsr,nclsr)

      err = ls_volerr(ifld_cls,exact,psiini)

      !Calculate Divergence norms of new VX,VY,VZ
      CALL OPDIV   (DVC,VX,VY,VZ)
      CALL DSSUM   (DVC,lx1,ly1,lz1)
      CALL COL2    (DVC,BINVM1,NTOT)

      CALL COL3    (DV1,DVC,BM1,NTOT)
      DIV1 = GLSUM (DV1,NTOT)/VOLVM1

      CALL COL3    (DV2,DVC,DVC,NTOT)
      CALL COL2    (DV2,BM1   ,NTOT)
      DIV2 = GLSUM (DV2,NTOT)/VOLVM1
      DIV2 = SQRT  (DIV2)
      if(nio.eq.0)then 
        write(*,*)"Volume error",err
        write(100,*)time,err,DIV1,DIV2
      endif

      if(istep.eq.nsteps .and. nio.eq.0) close(100)
      
      fplot = 0.1
      if(istep.eq.0)starttime = time
c     if(time-starttime .ge. fplot_next)then
c       fplot_next = fplot_next + fplot
c       pta(1) = 0.0
c       pta(2) = 0.0
c       pta(3) = 0.5
c       ptb(1) = 5.0
c       ptb(2) = 0.0
c       ptb(3) = 0.5
c       call lineplot(pta,ptb,1001)

c       pta(1) = 0.0
c       pta(2) = 0.0
c       pta(3) = 0.5
c       ptb(1) = 0.0
c       ptb(2) = 1.25
c       ptb(3) = 0.5
c       call lineplot(pta,ptb,1001)
c     endif

      return
      end
