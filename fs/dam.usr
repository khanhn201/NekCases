      include "experimental/lvlSet.f"
      include "experimental/lserrors.f"
c-----------------------------------------------------------------------
      subroutine uservp(ix,iy,iz,eg) ! set variable properties
      implicit none
      integer ix,iy,iz,eg,e
     
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      common /dimen/ Re,We,Fr,Pg
      real Re, We, Fr, Pg

      real rhoratio, muratio
      real udim, charl, rhol, mul, gdim, gamm
      real rhog,mug
      real psi
      integer icalld
      save icalld
      data icalld /0/


      e = gllel(eg)

!     These routine is not called by external solver
!     To Do: change the flow, so that this routine is called
!     similar to RANS. Will avoid confusion

      charl = 0.05715
      gdim = 9.81
      rhol = 1000.0
      rhog = 1.2e1

      mul = 1e-3
      mug = 1.8e-4 !/5.0

      udim = 1.0

      Re = 3.e4
      Pg = 1.1e-4
      We = 1.0/0.011269332539972
c     We = 10.0/0.011269332539972



      if(ifield.eq.1)then
        psi = t(ix,iy,iz,e,ifld_cls-1)
        psi = max(0.0,psi)
        psi = min(1.0,psi)
        utrans = ((1.0-psi)*rhog + psi*rhol)/rhol
        udiff = ((1.0-psi)*mug + psi*mul)/mul/Re

        if(istep.le.2)then
          vtrans0(ix,iy,iz,e) = utrans
        else
          vtrans0(ix,iy,iz,e) = rhog/rhol
        endif
      else
        utrans = 1.0
        udiff = 1e-10
        if(ifavm(ifield-1))then
          udiff = 1e-10       !must be tiny for hyperbolic
        elseif(ifsvv(ifield-1))then
          udiff = 1e-10      !must be tiny for hyperbolic
        endif
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userf(ix,iy,iz,eg) ! set acceleration term
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      common /dimen/ Re,We,Fr,Pg
      real Re,We,Fr,Pg
      real sfx,sfy,sfz

      real svvx,svvy,svvz
      real theta_g, psi, fgrav, facc

      e = gllel(eg)

      sfx = 0.0
      sfy = 0.0
      sfz = 0.0
      svvx = 0.0
      svvy = 0.0
      svvz = 0.0

      Re = 3.e4
      Pg = 1.1e-4
      call surfacetension(ix,iy,iz,e,1./We,sfx,sfy,sfz)
      
      call svv_fluid(ix,iy,iz,e,svvx,svvy,svvz)

      psi = t(ix,iy,iz,e,ifld_cls-1)

      fgrav = vtrans(ix,iy,iz,e,1)*((Re*Pg)**(-2))
      facc = 2.0*vtrans(ix,iy,iz,e,1)/Re

      ffx = 0.0 
      ffy = 0.0 
      ffz = 0.0 
c     ffx = sfx + svvx + facc/vtrans(ix,iy,iz,e,1)
c     ffy = sfy + svvy - fgrav/vtrans(ix,iy,iz,e,1)
c     ffz = sfz + svvz

      abfx(ix,iy,iz,e) = sfx + svvx + facc
      abfy(ix,iy,iz,e) = sfy + svvy - fgrav
      abfz(ix,iy,iz,e) = sfz + svvz
c     abfx(ix,iy,iz,e) = 0.0
c     abfy(ix,iy,iz,e) = 0.0
c     abfz(ix,iy,iz,e) = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine userq(ix,iy,iz,eg) ! set source term
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      real signls

      e = gllel(eg)
      
      qvol = 0.0
      avol = 0.0

      call limit_cls(ix,iy,iz,e)

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc(ix,iy,iz,iside,eg) ! set up boundary conditions
      implicit none
      integer ix,iy,iz,iside,eg

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /myvps/ uvw(lx1,ly1,lz1,lelt,3), myps(lx1,ly1,lz1,lelt,4)
      real uvw, myps

      integer e
      real yplus
      real xx,yy
      real y_height, v_local

      e = gllel(eg)

      xx = xm1(ix,iy,iz,e)
      yy = ym1(ix,iy,iz,e)

      ux   = 0.0
      uy   = 0.0
      uz   = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg) ! set up initial conditions
      implicit none
      integer ix,iy,iz,eg,e

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr
      real xx,yy, x_max

      common /fsarray/ ub(lx1,ly1,lz1,lelt),vb(lx1,ly1,lz1,lelt)
      real ub, vb
      common /fstemp/ temp_ic(lx1,ly1,lz1,lelv,2)
      real temp_ic
      real fsr, fsi, ax, disp, heaviside, h_local

      common /fsparam/ eps,alpha,gamma_r,gamma_i
      real gamma_r, eps, epsamp, alpha, gamma_i

      fsr    =   -0.222195390880021
      fsi    =   -0.777804609119979
      e = gllel(eg)

      xx = xm1(ix,iy,iz,e)
      yy = ym1(ix,iy,iz,e)

      ux = ub(ix,iy,iz,e)
      uy = vb(ix,iy,iz,e)
      uz = 0.0


      if(ifield.eq.2)then
        temp = temp_ic(ix, iy, iz, e, 1)
      endif
      if(ifield.eq.3)then
        temp = temp_ic(ix, iy, iz, e, 2)
      endif
      if(ifield.eq.4)then
        temp = temp_ic(ix, iy, iz, e, 1)
      endif
      if(ifield.eq.5)then
        temp = temp_ic(ix, iy, iz, e, 2)
      endif

      epsamp = eps*exp(gamma_r*time)
         ax = alpha*xx + gamma_i*time
         disp = fsr*cos(ax) - fsi*sin(ax)
         h_local = epsamp*disp

         temp = h_local - y
         if ((ifield.eq.2).or.(ifield.eq.4)) then
           temp = heaviside(ix,iy,iz,e,temp,0.0)
         endif
      
      return
      end
c-----------------------------------------------------------------------
      subroutine userchk()
      implicit none
      include 'SIZE'
      include 'TOTAL'


      real ntlsr, nclsr
      real pta(3),ptb(3)

      integer ntot,i

      COMMON /SCRNS/ DVC  (LX1,LY1,LZ1,LELV),
     $               DV1  (LX1,LY1,LZ1,LELV),
     $               DV2  (LX1,LY1,LZ1,LELV),
     $               DFC  (LX1,LY1,LZ1,LELV)
      real DVC,DV1,DV2,DFC
      real DIV1, DIV2
      real glsum
      integer pord
      integer ncut

      integer nface, f, e
      real w(lx1*ly1*lz1),w2(lx1*ly1*lz1)
      real bfluid(lx1*ly1*lz1*lelt)
      real total_flux, dq

      real fplot,fplot_next
      save fplot_next
      data fplot_next /0.0/

      common /myvisc/ visc(lx1,ly1,lz1,lelt)
      real visc

      real vol, vy2, vy20, gr, gl, ge, vy2r, vy2l,timestart
      real pr_avg
      real glsc3, glsc2

      save vy20, vy2l, timestart

      common /fsarray/ ub(lx1,ly1,lz1,lelt),vb(lx1,ly1,lz1,lelt)
      common /fstemp/ temp_ic(lx1,ly1,lz1,lelv,2)
      real ub, vb
      real temp_ic

      real vxx(lx1,ly1,lz1,lelt),vyy(lx1,ly1,lz1,lelt)
      real vzz(lx1,ly1,lz1,lelt)

      real psifluid(lx1,ly1,lz1,lelv)

      common /fsparam/ eps,alpha,gamma_r,gamma_i
      real gamma_r,gamma_i, eps, alpha

      common /fspres/ pres_ic(lx1,ly1,lz1,lelt)
      real pres_ic


      ntot = lx1*ly1*lz1*nelv



      pord = uparam(3)
      call extrappr(prext,pr,prlag(1,1,1,1,1),prlag(1,1,1,1,2),pord)
c     ncut = lx1-1
c     if(pord.ne.1) call cut_off_filter(prext,ncut,1)

      ntlsr = uparam(1) !freq of TLS re-distancing
      nclsr = uparam(2) !freq of CLS re-distancing

      call LS_default_driver(ntlsr,nclsr)

      ! Initialize the first 5 steps with the same IC
c     if (istep.lt.10) then
c       call gen_pert_ic
c       if (istep.lt.1) then
c         call copy(pr,pres_ic,ntot)
c         vol = glsum(bm1,ntot) ! recenter pressure
c         pr_avg = glsc2(bm1,pr,ntot)/vol
c         call cadd(pr, -pr_avg, ntot)
c       endif

c       if (istep.lt.10) then
c         call copy(t(1,1,1,1,1),temp_ic(1,1,1,1,1),ntot)
c         call copy(t(1,1,1,1,3),temp_ic(1,1,1,1,1),ntot)
c         do i=1,ntot
c           if ((temp_ic(i,1,1,1,1).ge.0.5).or.(istep.lt.10)) then
c             vx(i,1,1,1) = ub(i,1,1,1)
c             vy(i,1,1,1) = vb(i,1,1,1)
c           endif
c         enddo
c       endif
c     endif
      


      ! Calculate growth rate
      call copy(psifluid,t,ntot)
      do i=1,ntot
          if(psifluid(i,1,1,1).ge.0.5)then
            psifluid(i,1,1,1) = (psifluid(i,1,1,1)-0.5)*2.0
            psifluid(i,1,1,1) = 1.0
          else
            psifluid(i,1,1,1) = 0.0
          endif
          psifluid(i,1,1,1) = psifluid(i,1,1,1)
      enddo
      call col3(bfluid, bm1, psifluid, ntot)
      vol = glsum(bfluid,ntot)
      vy2 = glsc3(vy,bfluid,vy,ntot)/vol

      if (vy2.gt.0.0) vy2 = sqrt(vy2)

      if (istep.le.5) then
         vy20 = vy2
         timestart=time
      else
         vy2r = vy2/vy20
         vy2l = vy2/vy2l
         gr = log(vy2r)/(time-timestart)
         gl = log(vy2l)/dt
         ge = abs(gr - gamma_r)/gamma_r
         if (nid.eq.0) write(6,1) istep,time,vol,vy2,vy2r,gr,gl,ge
    1    format(i8,1p7e15.7,' AMP')
      endif
      vy2l = vy2




      fplot = 0.1
c     if(time .ge. fplot_next)then
         call copy(vxx,vx,ntot)
         call copy(vyy,vy,ntot)
         call copy(vzz,vz,ntot)
         call col2(vxx,psifluid,ntot)
         call col2(vyy,psifluid,ntot)
         call col2(vzz,psifluid,ntot)

         fplot_next = fplot_next + fplot
c        call outpost(vxx,vyy,vzz,vtrans,t(1,1,1,1,3),'dif')
c     endif



      return
      end
