[GENERAL]
polynomialOrder = 7
#startFrom = "restart.fld"
numSteps = 30000
dt = 1e-2
timeStepper = tombo2
writeInterval = 100


[PROBLEMTYPE]
equation = navierStokes

[FLUID PRESSURE]
residualTol = 1e-04

[FLUID VELOCITY]
residualTol = 1e-6
density = 1.0
viscosity = 1/500
solver=pcg+block
boundaryTypeMap = udfDirichlet, zeroNeumann
