c-----------------------------------------------------------------------
c     Carotid Artery .usr routine
c
c     Recent modifications:
c
c      o  August 12, 2002
c         Non-trivial divergence inserted near ICA outflow, in order
c         to ensure that all characteristics leave the domain.  (Requires
c         a change to navier4.f
c
c      o  Nov. 4, 2002
c         Changed Womersley to use splines
c
c
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,iel)                
      INCLUDE 'SIZE'   
      INCLUDE 'TOTAL'  
      INCLUDE 'NEKUSE' 
c
      integer istepo
      save    istepo
      data    istepo /0/
c
c
c     Be sure that param(1) = density
c                       (2) = dynamic viscosity
c                      (30) = 1.   (in order to force calling this routine)
c
      density   = 1.0
      viscosity = 4.0/500.0
 
      tau    = 0.5
      ramp0  = ramp_to_zero(time,tau)
      UDIFF  = viscosity * ( 1. +  5000.*ramp0 )
      UTRANS = density
 
c     if (nid.eq.0)  
c    $    write(6,1) istep,' udiff:',udiff,utrans,ramp0
    1 format(i8,a7,1p3e15.5)
      istepo = istep
 
      return
      end
c-----------------------------------------------------------------------
      function ramp_to_zero (time,tau)
      ramp_to_zero = 0.
      ramp_to_zero = 1.0*exp(-time/tau)
      return
c
      if (time.lt.0) then
         ramp_to_zero = 1.0
      elseif (time.lt.tau) then
         arg = 0.5*(3.14159)*time/tau
         ramp_to_zero = 1.-sin(arg)
      endif
c
      return
      end
c-----------------------------------------------------------------------
      subroutine userf  (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TSTEP'
C     include 'TOTAL'
      include 'NEKUSE'
C
      ffx = 0.0
      ffy = 0.0
      ffz = 0.0
      return
      end
c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
C
      qvol   = 0.0
      source = 0.0
      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'
c
      real flx(3)
c
      common /cvflow_l/ ifdivf
      logical ifdivf
c
      integer icalld
      save    icalld
      data    icalld  /0/
c
      common /myoutflow/ d(lx1,ly1,lz1,lelt),m1(lx1*ly1*lz1,lelt)
      real m1

      rq  = 1.5
      uin = 0.
c     call turb_outflow(d,m1,rq,uin)

      ifdivf = .false.    !  Set nontrivial divergence for outflow ICA bc.
      if (istep.gt.iostep) ifxyo = .false.  ! No geometry output after .fld01
c
      if (icalld.eq.0) then
         call set_graft
      endif
      icalld = icalld + 1
c
      if (icalld.gt.1) then
         call flux_adjust             ! Cannot call this till 1st step
         call flux_calc(flx,vx,vy,vz)
         if (nid.eq.0) write(6,1) istep,time,(flx(k),k=1,3)
    1    format(i10,1p4e15.7,'   flux')
      endif
c     call avg_all
c
      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TSTEP'
      include 'NEKUSE'
      include 'PARALLEL'
      include 'GEOM'
      include 'TOPOL'
c
      logical lsteady
c
      common /avgraft/ cgx0,cgy0,cgz0,are0,rad0,qvol0,vmax0
     $               , cgx1,cgy1,cgz1,are1,rad1,qvol1,vmax1
     $               , cgx2,cgy2,cgz2,are2,rad2,qvol2,vmax2
     $               , cgbar
     $               , unx0,uny0,unz0,unx1,uny1,unz1,unx2,uny2,unz2
c
      parameter (lin=lx1*ly1*lelt)
c
      real timel
      save timel
      data timel /-9999./
c
c
      ux   = 0.
      uy   = 0.
      uz   = 0.
      temp = 0.
c
      iface = eface1(iside)   !   Convert from prenek to nek numbering
c
      lsteady = .true.
c
c     This is the bc for the carotid
c
      ie = gllel(ieg)
      if (lsteady) then
        xx = x-cgx0
        yy = y-cgy0
        rr = xx*xx + yy*yy
c       uz = vmax0*(1.-rr/(rad0*rad0))
        um = vmax0*(1.-rr/(rad0*rad0))
        ux = -unx(ix,iy,iface,ie) * um
        uy = -uny(ix,iy,iface,ie) * um
        uz = -unz(ix,iy,iface,ie) * um
        temp= 1. + uz/vmax0
      else
        if (time.gt.timel) then
           timel = time
c          call set_womer
        endif
        xx = x-cgx0
        yy = y-cgy0
        zz = z-cgz0
        rt = xx*xx + yy*yy + zz*zz
        rr = rt/(rad0*rad0)
        if (rr.gt.0) rr = sqrt(rr)
        uwom = eval_womer(rr)
c
        tau   = 0.5
        if (time.lt.tau) then
           ramp0 = ramp_to_zero(time,tau)
           ramp1 = 1.-ramp0**6
           uwom  = uwom * (0.05 + 0.95*ramp1)
        endif
c
        ux   = -unx(ix,iy,iface,ie) * uwom   ! NOTE:  You must pay attention
        uy   = -uny(ix,iy,iface,ie) * uwom   !        to which boundary (5 or 6)
        uz   = -unz(ix,iy,iface,ie) * uwom   !        has the " v " BC.
      endif
c
      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TSTEP'
C     include 'TOTAL'
      include 'NEKUSE'
      ux=0.0
      uy=0.0
      uz=0.0
      temp=0
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdatx
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'

      integer e,eg,f

      n = lx1*ly1*lz1*nelt

      nface = 2*ldim
      
      do iel=1,nelt
      do ifc=1,2*ndim
         if (cbc(ifc,iel,1) .eq. 'W  ') then
           boundaryID(ifc,iel) = 1
         elseif (cbc(ifc,iel,1) .eq. 'v  ') then
           boundaryID(ifc,iel) = 2 ! Graft
         elseif (cbc(ifc,iel,1) .eq. 'O  ') then
           boundaryID(ifc,iel) = 3 ! Right (135deg to graft)
         elseif (cbc(ifc,iel,1) .eq. 'int') then
           boundaryID(ifc,iel) = 4 ! Left (45deg to graft)
         endif
      enddo
      enddo


      do iel=1,nelt
         do iface = 1, nface
            if (cbc(iface,iel,1) .eq. 'v  ') then ! Graft
               cbc(iface,iel,1) = 'O  '
            elseif (cbc(iface,iel,1) .eq. 'int') then ! Left (45deg to graft)
               cbc(iface,iel,1) = 'O  '
            elseif (cbc(iface,iel,1) .eq. 'O  ') then ! Right (135deg to graft)
               cbc(iface,iel,1) = 'v  '
            endif
         enddo 
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine set_graft
c
c     Set up bc's for inflow condition in AV graft
c
c
      include 'SIZE'
      include 'TOTAL'
c
      call find_outflow
c
c     Diagnostics to characterize domain size
c
      ntot = nx1*ny1*nz1*nelv
      xmin = glmin(xm1,ntot)
      ymin = glmin(ym1,ntot)
      zmin = glmin(zm1,ntot)
      xmax = glmax(xm1,ntot)
      ymax = glmax(ym1,ntot)
      zmax = glmax(zm1,ntot)
      dx   = xmax-xmin
      dy   = ymax-ymin
      dz   = zmax-zmin
      if (nid.eq.0) write(6,1) 'CAR:xyzlength',dx,dy,dz
    1 format(a13,1p3e12.3)
c
      return
      end
c-----------------------------------------------------------------------
      subroutine find_outflow
c
c     find outflow points to measure flow rate ratios in different
c     branches of bifurcation
c
c
      include 'SIZE'
      include 'TOTAL'
      common /scruz/ one(lx1,ly1,lz1)
c
      integer e,f
c
      common /avgraft/ cgx0,cgy0,cgz0,are0,rad0,qvol0,vmax0
     $               , cgx1,cgy1,cgz1,are1,rad1,qvol1,vmax1
     $               , cgx2,cgy2,cgz2,are2,rad2,qvol2,vmax2
     $               , cgbar
     $               , unx0,uny0,unz0,unx1,uny1,unz1,unx2,uny2,unz2
      common /avgrafi/ nsurf,nbrnch,iesurf(200),ifsurf(200),itsurf(200)
      character*1 cbb
c
c
      nbrnch = 3
c
      nxy  = nx1*ny1
      nxyz = nx1*ny1*nz1
      call rone(one,nxyz)
c
      vmax0 = 0.10
c
      jf    = 1
      nface = 2*ndim
c
      cgbar = 0.
      cgx0 = 0.
      cgy0 = 0.
      cgz0 = 0.
      are0 = 0.
      cgx1 = 0.
      cgy1 = 0.
      cgz1 = 0.
      are1 = 0.
      cgx2 = 0.
      cgy2 = 0.
      cgz2 = 0.
      are2 = 0.
      nsurf=0
      do e=1,nelv
      do f=1,nface
         cbb=cbc(f,e,jf)
         if (cbb.eq.'O  '.or.cbb.eq.'v  ') then
            ulx   = vlsc2(unx(1,1,f,e),area(1,1,f,e),nxy)
            uly   = vlsc2(uny(1,1,f,e),area(1,1,f,e),nxy)
            ulz   = vlsc2(unz(1,1,f,e),area(1,1,f,e),nxy)
            are   = facdot(one,area(1,1,f,e),f)
            cgx   = facdot(xm1(1,1,1,e),area(1,1,f,e),f)
            cgy   = facdot(ym1(1,1,1,e),area(1,1,f,e),f)
            cgz   = facdot(zm1(1,1,1,e),area(1,1,f,e),f)
            cgl   = cgy/are
            nsurf = nsurf+1
            iesurf(nsurf)=e
            ifsurf(nsurf)=f
            if (cbb.eq.'O  ') then
               if (boundaryID(f,e).eq.2) then ! graft
                  unx1 = unx1 + ulx
                  uny1 = uny1 + uly
                  unz1 = unz1 + ulz
                  cgx1 = cgx1 + cgx
                  cgy1 = cgy1 + cgy
                  cgz1 = cgz1 + cgz
                  are1 = are1 + are
                  itsurf(nsurf)=1
               else
                  unx2 = unx2 + ulx
                  uny2 = uny2 + uly
                  unz2 = unz2 + ulz
                  cgx2 = cgx2 + cgx
                  cgy2 = cgy2 + cgy
                  cgz2 = cgz2 + cgz
                  are2 = are2 + are
                  itsurf(nsurf)=2
               endif
            else
               unx0 = unx0 + ulx
               uny0 = uny0 + uly
               unz0 = unz0 + ulz
               cgx0 = cgx0 + cgx
               cgy0 = cgy0 + cgy
               cgz0 = cgz0 + cgz
               are0 = are0 + are
               itsurf(nsurf)=3
            endif
         endif
      enddo
      enddo
c
      are0 = glsum(are0,1)
      are1 = glsum(are1,1)
      are2 = glsum(are2,1)
c
      cgy1t = glsum(cgy1,1)
      cgy2t = glsum(cgy2,1)
      cgbar = (cgy1t+cgy2t)/(are1+are2)
c
      unx0 = glsum(unx0,1)/are0
      uny0 = glsum(uny0,1)/are0
      unz0 = glsum(unz0,1)/are0
      cgx0 = glsum(cgx0,1)/are0
      cgy0 = glsum(cgy0,1)/are0
      cgz0 = glsum(cgz0,1)/are0
c
      unx1 = glsum(unx1,1)/are1
      uny1 = glsum(uny1,1)/are1
      unz1 = glsum(unz1,1)/are1
      cgx1 = glsum(cgx1,1)/are1
      cgy1 = glsum(cgy1,1)/are1
      cgz1 = glsum(cgz1,1)/are1
c
      unx2 = glsum(unx2,1)/are2
      uny2 = glsum(uny2,1)/are2
      unz2 = glsum(unz2,1)/are2
      cgx2 = glsum(cgx2,1)/are2
      cgy2 = glsum(cgy2,1)/are2
      cgz2 = glsum(cgz2,1)/are2
c
      call norm3dv(unx0,uny0,unz0)
      call norm3dv(unx1,uny1,unz1)
      call norm3dv(unx2,uny2,unz2)
c
      pi = 4.*atan(one(1,1,1))
      rad0 = sqrt(are0/pi)
      rad1 = sqrt(are1/pi)
      rad2 = sqrt(are2/pi)
c
      if (nid.eq.0) then
         write(6,1) 'CAR: cgbar',cgbar,cgy1,cgy2
         write(6,1) 'CAR: cgx12',cgx1,cgx2,cgx0
         write(6,1) 'CAR: cgy12',cgy1,cgy2,cgy0
         write(6,1) 'CAR: cgz12',cgz1,cgz2,cgz0
         write(6,1) 'CAR: are12',are1,are2,are0
         write(6,1) 'CAR: rad12',rad1,rad2,rad0
    1    format(a10,1p3e12.4)
      endif
c
      return
      end
c-----------------------------------------------------------------------
      subroutine set_flx_msk   (m1,m2,m3,ibranch)
c
      include 'SIZE'
      include 'TOTAL'
c
      common /avgrafi/ nsurf,nbrnch,iesurf(200),ifsurf(200),itsurf(200)
      common /scruz/   one(lx1,ly1,lz1)
c
      real m1(lx1,ly1,lz1,lelv)
      real m2(lx1,ly1,lz1,lelv)
      real m3(lx1,ly1,lz1,lelv)
      integer e,f
c
      nfound = 0
      do i=1,nsurf
         j=itsurf(i)
         f=ifsurf(i)
         e=iesurf(i)
         if (j.ne.ibranch.and.j.ne.0) then
            nfound = nfound+1
            call facev(m1,e,f,0.,nx1,ny1,nz1)
            call facev(m2,e,f,0.,nx1,ny1,nz1)
            call facev(m3,e,f,0.,nx1,ny1,nz1)
         endif
      enddo
c     write(6,*) nid,'CAR:  #outflow:',nfound,ibranch
      xfound = nfound
      xfound = glsum(xfound,1)
      nfound = xfound
      if (nid.eq.0) write(6,*) 'CAR:  #outflow:',nfound,ibranch
c
      return
      end
c-----------------------------------------------------------------------
      subroutine flux_calc(flux,ux,uy,uz)
c
c     Coupte outflow fluxes in different branches of bifurcation
c
c
      include 'SIZE'
      include 'TOTAL'
c
      real flux(3)
      real ux(lx1,ly1,lz1,lelv)
      real uy(lx1,ly1,lz1,lelv)
      real uz(lx1,ly1,lz1,lelv)
c
c
      common /avgraft/ cgx0,cgy0,cgz0,are0,rad0,qvol0,vmax0
     $               , cgx1,cgy1,cgz1,are1,rad1,qvol1,vmax1
     $               , cgx2,cgy2,cgz2,are2,rad2,qvol2,vmax2
     $               , cgbar
     $               , unx0,uny0,unz0,unx1,uny1,unz1,unx2,uny2,unz2
      common /avgrafi/ nsurf,nbrnch,iesurf(200),ifsurf(200),itsurf(200)
      integer e,f
c
c
      call rzero(flux,nbrnch)
      do i=1,nsurf
         j=itsurf(i)
         f=ifsurf(i)
         e=iesurf(i)
         flux(j) = flux(j)+ facint(ux,unx,area,f,e)
     $           +          facint(uy,uny,area,f,e)
     $           +          facint(uz,unz,area,f,e)
      enddo
c
      do j=1,nbrnch
         flux(j) = glsum(flux(j),1)
      enddo
c
c
      return
      end
c-----------------------------------------------------------------------
      subroutine flux_adjust
c
c     Adust flow volume at end of time step to keep flow rate fixed by
c     adding an appropriate multiple of the linear solution to the Stokes
c     problem.
c
c     pff 6/28/98  (updated Jan 11/2001)
c
      include 'SIZE'
      include 'TOTAL'
c
c     Swap the comments on these two lines if you don't want to fix the
c     flow rate for periodic-in-X flow problems.
c
      common /cvflow_a/ vxc(lx1,ly1,lz1,lelv)
     $                , vyc(lx1,ly1,lz1,lelv)
     $                , vzc(lx1,ly1,lz1,lelv)
     $                , prc(lx2,ly2,lz2,lelv)
      common /cvflow_r/ flow_rate,base_flow,flx(3)
c
      real bd_vflow,dt_vflow
      save bd_vflow,dt_vflow
      data bd_vflow,dt_vflow /-99.,-99./
c
c     Check list:
c
c     param (56) -- percentage through ECA   (most x location)
c
c
      ntot1 = nx1*ny1*nz1*nelv
      ntot2 = nx2*ny2*nz2*nelv
c
c
      param(56) = 0.3
      if (param(56).eq.0.) return
c
c
c     If either dt or the backwards difference coefficient change,
c     then recompute base flow solution corresponding to unit forcing:
c
      if (dt.ne.dt_vflow.or.bd(1).ne.bd_vflow)
     $   call compute_flx_soln(flx,vxc,vyc,vzc,prc)
c
      dt_vflow = dt
      bd_vflow = bd(1)
c
      call flux_calc(flx,vx,vy,vz)
c
c     total_flux    = flx(1)+flx(2)       ! 8/3/02, pff.
      total_flux    = -flx(3)             ! flx(1) is messed up because of
      flx1          = -(flx(2)+flx(3))    ! special outflow bc for turbulence
      tau           = 0.5          ! Ramp-up flux adjust over t=.075--.125
c
      flux2_desired = param(56)*total_flux
      dflux2 = ( flux2_desired-flx(2) ) * (1.-ramp_to_zero(time,tau))
      scale  = dflux2/base_flow
c
      old1 = flx(1)/total_flux
      old2 = flx(2)/total_flux
c
      if (nid.eq.0)
     $   write(6,1) istep,time,scale,dflux2,total_flux,base_flow
     $            , flx(3),flx(1),flx(2),flx1
     $            , old1,old2
    1    format(i8,e14.7,8e11.3,2f6.3,' CAR:volflow')
c
      call add2s2(vx,vxc,scale,ntot1)
      call add2s2(vy,vyc,scale,ntot1)
      call add2s2(vz,vzc,scale,ntot1)
      call add2s2(pr,prc,scale,ntot2)
c
      return
      end
c-----------------------------------------------------------------------
      subroutine compute_flx_soln(flx,vxc,vyc,vzc,prc)
c
c     Compute the solution to the time-dependent Stokes problem
c     with unit forcing, and find associated flow rate.
c
c     pff 2/28/98
c
      include 'SIZE'
      include 'TOTAL'
c
      real vxc(lx1,ly1,lz1,lelv)
     $   , vyc(lx1,ly1,lz1,lelv)
     $   , vzc(lx1,ly1,lz1,lelv)
     $   , prc(lx2,ly2,lz2,lelv)
     $   , flx(3)
c
      common /cvflow_r/ flow_rate,base_flow
      common /cvflow_l/ ifdivf
      logical ifdivf
c
      integer icalld
      save    icalld
      data    icalld/0/
c
c
      ntot1 = nx1*ny1*nz1*nelv
      ntot2 = nx2*ny2*nz2*nelv
c     ntot1 = lx1*ly1*lz1*lelv
c     ntot2 = lx2*ly2*lz2*lelv
c
      if (ifsplit) then
         write(6,*) 'CAR: no flux adjust for plan2, ABORT'
         call exitt
      else
         ifdivf = .true.
         call rzero(vxc,ntot1)
         call rzero(vyc,ntot1)
         call rzero(vzc,ntot1)
         call rzero(prc,ntot2)
         call plan3_flx(vxc,vyc,vzc,prc,1)
c        call outpost(vxc,vyc,vzc,prc,vxc,'p11')
         call flux_calc(flx,vxc,vyc,vzc)
c
         call chsign(vxc,ntot1)
         call chsign(vyc,ntot1)
         call chsign(vzc,ntot1)
         call chsign(prc,ntot2)
c
         call plan3_flx(vxc,vyc,vzc,prc,2)
c        call outpost(vxc,vyc,vzc,prc,vxc,'p12')
         call flux_calc(flx,vxc,vyc,vzc)
         if (nid.eq.0) write(6,*) 'CAR: flow 2:',flx(1),flx(2),flx(3)
         ifdivf = .false.
      endif
c
c     Compute base flow rate  
c
      flx2      = -(flx(1)+flx(3))    ! special outflow bc for turbulence
      base_flow = 0.5*(flx2-flx(1))
c
      if (nid.eq.0)
     $   write(6,1) istep,base_flow,flx(1),flx2,flx(2)
    1    format(i9,1p4e13.5,'CAR:  basflow')
c
      return
      end
c-----------------------------------------------------------------------
      subroutine plan3_flx(vxc,vyc,vzc,prc,ibranch)
c
c     Compute pressure and velocity using fractional step method.
c     (PLAN3).
c
c
      include 'SIZE'
      include 'TOTAL'
c
      real vxc(lx1,ly1,lz1,lelv)
     $   , vyc(lx1,ly1,lz1,lelv)
     $   , vzc(lx1,ly1,lz1,lelv)
     $   , prc(lx2,ly2,lz2,lelv)
C
      COMMON /SCRNS/ rw1   (LX1,LY1,LZ1,LELV)
     $ ,             rw2   (LX1,LY1,LZ1,LELV)
     $ ,             rw3   (LX1,LY1,LZ1,LELV)
     $ ,             dv1   (LX1*LY1*LZ1*LELV)
     $ ,             dv2   (LX1*LY1*LZ1*LELV)
     $ ,             dv3   (LX1*LY1*LZ1*LELV)
     $ ,             RESPR (LX2,LY2,LZ2,LELV)
      COMMON /SCRCH/ H1M2  (LX2*LY2*LZ2,LELV)  ! must force for precond. EPREC
     $ ,             H2M2  (LX2*LY2*LZ2,LELV)  ! 3/22/02
      COMMON /SCRVH/ H1    (LX1*LY1*LZ1,LELV)
     $ ,             H2    (LX1*LY1*LZ1,LELV)
      COMMON /SCRHI/ H2INV (LX1*LY1*LZ1*LELV)
c
      COMMON /SCRSF/ sk1(LX1,LY1,LZ1,LELT)
     $ ,             sk2(LX1,LY1,LZ1,LELT)
     $ ,             sk3(LX1,LY1,LZ1,LELT)
       integer e
c
c
c     Compute velocity, 1st part
c
      ntot1  = nx1*ny1*nz1*nelv
      ntot2  = nx2*ny2*nz2*nelv
c     ntot1 = lx1*ly1*lz1*lelv
c     ntot2 = lx2*ly2*lz2*lelv
      ifield = 1
c
c
c     Reset mask
c
      call opcopy        (sk1,sk2,sk3,v1mask,v2mask,v3mask)
      call set_flx_msk   (v1mask,v2mask,v3mask,ibranch)
c
      call rzero    (dv1,ntot1)
      call rzero    (dv2,ntot1)
      call rzero    (dv3,ntot1)
      call bcdirvc  (dv1,dv2,dv3,v1mask,v2mask,v3mask)
c
      dvmax = 0    !  rescale velocity to have roughly unit norm
      do i=1,ntot1
         dvel  = dv1(i)*dv1(i)+dv2(i)*dv2(i)+dv3(i)*dv3(i)
         dvmax = max(dvmax,dvel)
      enddo
      dvmax = glmax(dvmax,1)
      dvmax = sqrt (dvmax)
      scale = 10./dvmax
      call cmult(dv1,scale,ntot1)
      call cmult(dv2,scale,ntot1)
      call cmult(dv3,scale,ntot1)
c
      intype = -1
      call cfill    (vdiff,4.0/500.0,ntot1)       ! put target viscosity
      call sethlm   (h1,h2,intype)
      call ophx     (rw1,rw2,rw3,dv1,dv2,dv3,h1,h2)
      call ophinv   (dv1,dv2,dv3,rw1,rw2,rw3,h1,h2,tolhv,nmxh)
      call bcdirvc  (dv1,dv2,dv3,v1mask,v2mask,v3mask)
      call ssnormd  (dv1,dv2,dv3)
      call opadd2   (vxc,vyc,vzc,dv1,dv2,dv3)
c
c     Compute pressure  (from "incompr")
c
      intype = 1
c     dtinv  = 1./dt   ! Why not bd(1)/dt ??
      dtinv  = bd(1)/dt   ! Why not bd(1)/dt ??
c
      call rzero   (h1,ntot1)
      call copy    (h2,vtrans(1,1,1,1,ifield),ntot1)
      call cmult   (h2,dtinv,ntot1)
      do e=1,nelv
        call map12(h1m2(1,e),h1(1,e),e)
        call map12(h2m2(1,e),h2(1,e),e)
      enddo
      call invers2 (h2inv,h2,ntot1)
      call opdiv   (respr,dv1,dv2,dv3)
      call chsign  (respr,ntot2)
      call ortho   (respr)
c
c     Set istep=0 so that h1/h2 will be re-initialized in eprec
      i_tmp = istep
      istep = 0
      call esolver (respr,h1,h2,h2inv,intype)
      istep = i_tmp
c
      call opgradt (rw1,rw2,rw3,respr)
      call opbinv  (dv1,dv2,dv3,rw1,rw2,rw3,h2inv)
      call opadd2  (vxc,vyc,vzc,dv1,dv2,dv3)
c
      vxcn = glmin(vxc,ntot1)
      vycn = glmin(vyc,ntot1)
      vzcn = glmin(vzc,ntot1)
      dv1n = glmin(dv1,ntot1)
      dv2n = glmin(dv2,ntot1)
      dv3n = glmin(dv3,ntot1)
c
      vxcm = glmax(vxc,ntot1)
      vycm = glmax(vyc,ntot1)
      vzcm = glmax(vzc,ntot1)
      dv1m = glmax(dv1,ntot1)
      dv2m = glmax(dv2,ntot1)
      dv3m = glmax(dv3,ntot1)
c
      if (nid.eq.0) then
         write(6,1) 'base_vcmn',vxcn,vycn,vzcn
         write(6,1) 'base_vcmx',vxcm,vycm,vzcm
         write(6,1) 'base_dvmn',dv1n,dv2n,dv3n
         write(6,1) 'base_dvmx',dv1m,dv2m,dv3m
      endif
    1 format(a9,1p3e14.5)
      call add2    (prc,respr,ntot2)
c
c     Reset mask
      call opcopy  (v1mask,v2mask,v3mask,sk1,sk2,sk3)
c
      return
      end

c-----------------------------------------------------------------------
c     Womersley profile below
c-----------------------------------------------------------------------
      function womer(radius,time)
c
       integer icalld
       save    icalld
       data    icalld /0/
       real    acoeff(100),bcoeff(100),alpha(100)
       complex ccoeff(100),aj1(100),aj0(100),qc1,qc2,ae,ayj0,zivalue,sq
c
       one = 1.
       pi  = 4.*atan(one)
c
c      Results are in m/s
c
c      All values are in mks units, except for Q, which is in liters/min.
c
       if (icalld.eq.0) then
         icalld=1
         open(unit=81,file='cl.fft')
         read(81,*)jmax,imax,start,end,vis,rho,radread,freqbpm,womp
         write(6,*)'  CAR:Reading fft info'
         read(81,*)itype,ncoeff,qmean
         do 10 i=1,ncoeff
           read(81,*)Acoeff(I),Bcoeff(I)
  10     continue
         close(81)
       endif
c
       qunits=1000000.
       qscale=-8.*vis/pi/(radread**4)/1000./60.
       cmean=-qscale*qmean
c
       do 40 i=1,ncoeff
         ccoeff(i)=cmplx(Acoeff(i),-Bcoeff(i))
 40    continue
c
       velocity =-cmean*radread*radread/4.0/vis*(radius**2-1.)
c      write(6,*) 'velocity:',velocity,cmean,radius,radread
       omega=freqbpm*2.*pi/60.
       zivalue=cmplx(0.,1.)
       two = 2.
       sq2 = sqrt(two)/2.
       sq=cmplx(sq2,-sq2)
       zero=0.0
c
       do 100 k=1,ncoeff
         alpha(K)=radread*sqrt(float(k)*omega*rho/vis)
         alph=alpha(k)
         call j0j1(alph,bessela,besselb,besselc,besseld,itnum)
c        if (itnum.gt.100) write(61,*)alph,itnum
         aj1(k)=cmplx(besselc,besseld)
         aj0(k)=cmplx(bessela,besselb)
         qc1=-zivalue+2.*aj1(k)/alph*sq/aj0(k)
         qc2=cmplx(pi*radread**4/alph**2/vis*1000.*60.,zero)
         ccoeff(k)=ccoeff(k)/qc1/qc2
 100   continue
c
       period = 60./freqbpm 
       theta=time/period*360.
c      write(61,*)'time  theta  raidus  U    V     W  steady value is: ',velocity
c
       do 120 k=1,ncoeff
         alph=alpha(k)
         omegat=float(k)*omega*time
         ae=ccoeff(k)*cmplx(cos(omegat),sin(omegat))
         ahere=alpha(k)*radius
         call j0j1(ahere,a1,a2,d1,d2,itnum)
         ayj1=cmplx(d1,d2)
         ayj0=cmplx(a1,a2)
         wcomp=(ayj0/aj0(k)-1.0)*zivalue*ae
         wtemp=radread*radread/vis/(alph**2)*real(wcomp)
         velocity=wtemp+velocity
 120   continue
c
       u = 0
       v = 0
       w = velocity
       womer = w
c      write(61,1200)time,theta,radius,U,V,W
 1200  format( f8.6,2x,f5.1,2x,5(f11.8,2x) )
 1201  format( 8(f11.8,2x) )
c
       return
       end
c

CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C
C     This program computes the Kelvin Functions otherwise know as the
C     BER BEI functions
C
C     Solution was taken from Milton Abramowitz and I.A. Stegun text
C     "Handbook of Mathematical Functions with Formulas Graphs, and
C     Mathematical Tables", Dover Publications, Inc. New York, 1972,
C     pages 379 and 430. The maximum value that may be calculated is
C     z=90 because the factorial has a limitation of 90
c
CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
C
C     The routine J0J1 calculates the BER BEI quantities for order
C     zero and one
C
      subroutine j0j1(ZBESSEL,ber0,bei0,ber1,bei1,n)
C
C     Double precision is employed for better resolution
C
      REAL*8 R0,I0,R1,I1,BER0Z,BEI0Z,BER1Z,BEI1Z,TEMP0,TEMP1,PI,
     & ERRMAX,zbessel2,FAC,zbessel,BER0,BEI0,BER1,BEI1
      INTEGER*4 I,N

C
C     If the aurgument is ZERO then values are designated immediately
C
      ERRMAX=1.0E-6
      IF(zbessel.LT.0.0000001)THEN
      R0=1.0
      I0=0.0
      R1=0.0
      I1=0.0
      GOTO 199
      ENDIF
      PI=3.141592653589793
C
C     The sums are initialized to their proper values
C
      IC1=0
      IC2=0
      IC3=0
      IC4=0
      BER0Z=1.0
      BEI0Z=0.0
      BER1Z=COS(3./4.*PI)
      BEI1Z=SIN(3./4.*PI)
C
C     Loop is to 100 but this is not really nescessary convergence is
C     generally obtained quickly
C
      zbessel2=0.25*zbessel*zbessel
      DO 10 I=1,100
      TEMP0=zbessel2**I/(FAC(I))**2

      I0=BEI0Z+TEMP0*SIN(0.5*FLOAT(I)*PI)
      IF(ABS(TEMP0/I0).LT.ERRMAX.AND.I.GT.2)  IC1=1

      R0=BER0Z+TEMP0*COS(0.5*FLOAT(I)*PI)
      IF(ABS(TEMP0/R0).LT.ERRMAX.AND.I.GT.2)  IC2=1

      TEMP1=TEMP0/(FLOAT(I)+1)

      I1=BEI1Z+TEMP1*SIN((3./4.+0.5*FLOAT(I))*PI)
      IF(ABS(TEMP1/I1).LT.ERRMAX.AND.I.GT.2)  IC3=1

      R1=BER1Z+TEMP1*COS((3./4.+0.5*FLOAT(I))*PI)
      IF(ABS(TEMP1/R1).LT.ERRMAX.AND.I.GT.2)  IC4=1

      IF(IC1.EQ.1.AND.IC2.EQ.1.AND.IC3.EQ.1.AND.IC4.EQ.1) GOTO 199

      BER0Z=R0
      BEI0Z=I0
      BER1Z=R1
      BEI1Z=I1
  10  CONTINUE
 199  N=I
      BER0=R0
      BEI0=I0
      BER1=R1*zbessel/2.
      BEI1=I1*zbessel/2.
      RETURN
      END


      FUNCTION FAC(N)
      REAL*8 FAC,F
      INTEGER*4 JJ,N
      IF(N.EQ.0) THEN
      FAC=1.
      GOTO  112
      ENDIF
      F=FLOAT(N)
      DO 111 JJ=1,N-1
      F=F*(N-JJ)
 111  CONTINUE
      FAC=F
 112  RETURN
      END
c-----------------------------------------------------------------------
      subroutine norm3dv(u1,u2,u3)
C
C     normalize a 3 component vector
C
      vlngth = u1*u1+u2*u2+u3*u3
      if (vlngth.gt.0) then
         vlngth = sqrt(vlngth)
         u1     = u1 / vlngth
         u2     = u2 / vlngth
         u3     = u3 / vlngth
      endif
C
      return
      end
c-----------------------------------------------------------------------
      subroutine set_womer
c
c     Evaluate Womersely profile at several knot points in r, and set
c     up a spline along these points.
c
      INCLUDE 'SIZE'   
      INCLUDE 'TSTEP'  
c
      parameter (kn=20)
      common /womers/ rj(0:kn),uj(0:kn),ujr(0:kn),ujrr(0:kn)
c
      time_womer = time + 0.5  !  .5 second shift  (See p. 37 S. Lee Thesis)
      time_womer = 0.1
c
      dr = 1./kn
      do j=0,kn
         r       = j*dr
         rj (j)  = r
         uj (j)  = womer(r,time_womer)
      enddo
c
c     Set up clamped spline on [0,1].
c
      n1   = kn+1
      big  = 1.e24
      zero = 0.
      call splinen(ujr,ujrr,rj,uj,n1,zero,big)
c
      return
      end
c-----------------------------------------------------------------------
      function eval_womer(r)
c
      parameter (kn=20)
      common /womers/ rj(0:kn),uj(0:kn),ujr(0:kn),ujrr(0:kn)
c
      eval_womer = 0.
      if (r.gt.1.0) return
c
      n1 = kn+1
      call splintn(y,yp,ypp,r,rj,uj,ujrr,n1,ierr)
      eval_womer = y
c
      return
      end
c-----------------------------------------------------------------------
      subroutine splinen(u,y2,x,y,n,yp1,ypn)
c
c     p. 88-89, numerical recipes
c
      real u(n),y2(n),x(n),y(n)   ! u is a work array, filled with y' 
      big = 1.e20
c
      if (yp1.gt.big) then
         y2(1) = 0
         u (1) = 0
      else
         dx    = x(2)-x(1)
         dy    = y(2)-y(1)
         y2(1) = -.5
         u (1) = 3.*(dy/dx - yp1) / dx
      endif
c
      do i=2,n-1
         ir=i+1
         il=i-1
         sig=(x(i)-x(il))/(x(ir)-x(il))
         p=sig*y2(il)+2.
         y2(i)=(sig-1.)/p
         u(i)= ( 6.*
     $     ( (y(ir)-y(i))/(x(ir)-x(i))-(y(i)-y(il))/ (x(i)-x(il) ) )
     $            / (x(ir)-x(il))
     $    - sig*u(il) )/p
      enddo
c
      if (ypn.gt.big) then
         qn=0.0
         un=0.0
      else
         dx    = x(n)-x(n-1)
         dy    = y(n)-y(n-1)
         qn    = 0.5
         un    = -3.*(dy/dx - ypn) / dx
      endif
c
      y2(n) = (un-qn*u(n-1)) / (qn*y2(n-1)+1.)
      do k=n-1,1,-1
         y2(k)=y2(k)*y2(k+1)+u(k)
      enddo
c
c     Stuff y' into u:
c
      do k=1,n-1
         dx = x(k+1) - x(k)
         dy = y(k+1) - y(k)
         yp = dy/dx  - (2*y2(k) + y2(k+1))*dx/6.
         u(k) = yp
      enddo
      u(n)  = dy/dx  + (y2(n-1) + 2*y2(n))*dx/6.
c
      return
      end
c-----------------------------------------------------------------------
      subroutine splintn(y,yp,ypp,x,xa,ya,y2a,n,ierr)
c
c     Returns y(x), y'(x), y"(x), after "spline" call.
c
c
c     p. 88-89, numerical recipes
c
      real xa(n),ya(n),y2a(n)
c
      integer klo_last
      save    klo_last
      data    klo_last /-99/
c
      logical ifbracket
c
      ierr = 0
      y    = 0
      yp   = 0
      ypp  = 0
c
      ifbracket = .false.
      if (0.lt.klo_last.and.klo_last.lt.n) then
         klo = klo_last 
         khi = klo + 1
         if (xa(klo).le.x.and.x.le.xa(khi)) ifbracket=.true.
      endif
c
      if (.not.ifbracket) then
c
c        Check total range   (assumption is that abscissa is sorted)
c
         if (x.lt.xa(1)) then
            y = ya(1)
            ierr = -1
            return
         elseif (x.gt.xa(n)) then
            y = ya(n)
            ierr = -2
            return
         endif
c
c        Search
c
         klo=1
         khi=n
    1    if ((khi-klo).gt.1) then
           k=(khi+klo)/2
           if (xa(k).gt.x) then
              khi=k
           else
              klo=k
           endif
           goto 1
        endif
      endif
c
      klo_last = klo
c
      x1  = xa(klo)
      x2  = xa(khi)
      y1  = ya(klo)
      y2  = ya(khi)
      y21 = y2a(klo)
      y22 = y2a(khi)
c
      dx = x2-x1
      dy = y2-y1
      if (dx.eq.0) then
         write(6,*) xa(khi), 'ERROR in splint',khi
         ierr = 1
         return
      endif
c
      a=(x2-x)/dx
      b=(x-x1)/dx
c
      y   = a*y1+b*y2 + ((a**3- a)*y21 + (b**3- b)*y22)*(dx**2)/6.
      yp  = dy/dx -     ((3*a*a-1)*y21 - (3*b*b-1)*y22)* dx    /6.
      ypp = a*y21+b*y22
c
      return
      end
c-----------------------------------------------------------------------
