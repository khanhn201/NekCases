c-----------------------------------------------------------------------
c     Carotid Artery .usr routine
c
c     Recent modifications:
c
c      o  August 12, 2002
c         Non-trivial divergence inserted near ICA outflow, in order
c         to ensure that all characteristics leave the domain.  (Requires
c         a change to navier4.f
c
c      o  Nov. 4, 2002
c         Changed Womersley to use splines
c
c
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,iel)                
      INCLUDE 'SIZE'   
      INCLUDE 'TOTAL'  
      INCLUDE 'NEKUSE' 
 
      return
      end
c-----------------------------------------------------------------------
