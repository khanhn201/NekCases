[GENERAL]
polynomialOrder = 5
#startFrom = "restart.fld"
numSteps = 100000
dt = 1e-3
timeStepper = tombo2
writeInterval = 1000


[PROBLEMTYPE]
equation = navierStokes

[FLUID PRESSURE]
residualTol = 1e-8

[FLUID VELOCITY]
residualTol = 1e-8
density = 1.0
viscosity = 4/500
solver=pcg+block
boundaryTypeMap = zeroDirichlet, udfDirichlet, zeroNeumann
