userSections = CASEDATA

[GENERAL]
polynomialOrder = 7
numSteps = 1000000
dt = 5e-04
timeStepper = tombo2
checkpointInterval = 100
advectionSubCyclingSteps = 2

udf = "../tony.udf"

scalars = TEMPERATURE

[NEKNEK]
boundaryEXTOrder = 1


[PROBLEMTYPE]
equation = navierStokes+variableViscosity

[FLUID PRESSURE]
residualTol = 1e-08

[FLUID VELOCITY]
residualTol = 1e-12
density = 1.0
viscosity = 1.0/5000.0
boundaryTypeMap = int, zeroDirichlet

[SCALAR TEMPERATURE]
residualTol = 1e-12
transportCoeff = 1.0
diffusionCoeff = 1.0/3500.0
boundaryTypeMap = int, udfDirichlet


[CASEDATA]
