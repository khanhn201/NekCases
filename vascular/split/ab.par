[GENERAL]
numSteps = 50000
dt = 5e-4
# timeStepper = tombo2
writeInterval = 20

filtering = hpfrt
filterModes = 2
filterWeight = 5.0

[PROBLEMTYPE]
# equation = navierStokes+variableViscosity
variableProperties = yes

[PRESSURE]
residualTol = 1e-6

[VELOCITY]
residualTol = 1e-8
density = 1.0
viscosity = -2000.0

[TEMPERATURE]
solver = none
