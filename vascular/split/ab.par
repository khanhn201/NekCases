[GENERAL]
numSteps = 50000
dt = 1e-4
# timeStepper = tombo2
writeInterval = 100

filtering = hpfrt
filterModes = 2
filterWeight = 10.0

[PROBLEMTYPE]
# equation = navierStokes+variableViscosity
variableProperties = yes

[PRESSURE]
residualTol = 1e-6

[VELOCITY]
residualTol = 1e-8
density = 1050.0
viscosity = 0.0035

[TEMPERATURE]
solver = none
