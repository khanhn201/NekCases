#ifdef __okl__

void udfDirichlet(bcData *bc)
{
  if (isField("mhd inductionless")) {
    bc->sScalar = 0.0;
  }
}

#endif


static dfloat P_GAMMA_R;
static dfloat P_GAMMA_I;
static dfloat P_ALPHA;
static dfloat P_FZ;
static dfloat P_EPS;

void userf(double time)
{
  auto &fluid = nrs->fluid;
  auto mesh = fluid->mesh;

  auto o_FUz = fluid->o_EXT.slice(2 * fluid->fieldOffset, fluid->fieldOffset);
  platform->linAlg->fill(mesh->Nlocal, P_FZ, o_FUz);
}

void UDF_LoadKernels(deviceKernelProperties& kernelInfo)
{

}


void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  platform->par->extract("casedata", "p_fz", P_FZ);
  platform->par->extract("casedata", "p_gamma_r", P_GAMMA_R);
  platform->par->extract("casedata", "p_gamma_i", P_GAMMA_I);
  platform->par->extract("casedata", "p_alpha", P_ALPHA);
  platform->par->extract("casedata", "p_eps", P_EPS);
  if (platform->options.compareArgs("BUILD ONLY", "FALSE")) {
    *nek::ptr<double>("p_gamma_r") = P_GAMMA_R;
    *nek::ptr<double>("p_gamma_i") = P_GAMMA_I;
    *nek::ptr<double>("p_alpha") = P_ALPHA;
    *nek::ptr<double>("p_eps") = P_EPS;
  }
}
void UDF_Setup()
{
  platform->par->extract("casedata", "p_fz", fz); 
  nrs->userSource = &userf;

  auto &fluid = nrs->fluid;
  auto &mhdIndless = nrs->mhdIndless;

  if (platform->options.getArgs("RESTART FILE NAME").empty()) { // IC
    { // velocity
      auto mesh = fluid->mesh;
      auto [x, y, z] = mesh->xyzHost(); // x[n], y[n], z[n]
      std::vector<dfloat> U(mesh->dim * fluid->fieldOffset, 0.0);
      std::vector<dfloat> P(fluid->fieldOffset, 0.0);

      for (int n = 0; n < mesh->Nlocal; n++) {
        U[n + 0 * fluid->fieldOffset] = 0.0;
        U[n + 1 * fluid->fieldOffset] = 0.0;
        U[n + 2 * fluid->fieldOffset] = 0.0;
        P[n] = 0.0;
      }
      fluid->o_U.copyFrom(U.data(), U.size());
      fluid->o_P.copyFrom(P.data(), P.size());
    }

    if (nrs->mhdIndless) { // inductless B field
      auto mesh = mhdIndless->mesh;
      auto [x, y, z] = mesh->xyzHost(); // x[n], y[n], z[n]
      std::vector<dfloat> Phi(mhdIndless->fieldOffset, 0.0);
      for (int n = 0; n < mesh->Nlocal; n++) {
        Phi[n] = 0.0;
      }
      mhdIndless->o_Phi.copyFrom(Phi.data(), Phi.size());
    }
  }

  if (nrs->mhdIndless) { // applied B filed
    auto mesh = mhdIndless->mesh;
    auto [x, y, z] = mesh->xyzHost(); // x[n], y[n], z[n]
    std::vector<dfloat> B(3 * mhdIndless->fieldOffset, 0.0);

    dfloat b0y = 0.0;
    platform->options.getArgs("MHD MAGNETIC BY", b0y);
    for (int n = 0; n < mesh->Nlocal; n++) {
      B[n + 0 * mhdIndless->fieldOffset] = 0.0;
      B[n + 1 * mhdIndless->fieldOffset] = b0y;
      B[n + 2 * mhdIndless->fieldOffset] = 0.0;
    }
    mhdIndless->o_B.copyFrom(B.data(), B.size());
  }
}

dfloat vy_0 = 1.0;
dfloat vy_last = 1.0;
dfloat time_start = 0.0;

void UDF_ExecuteStep(double time, int tstep)
{
  if (!nrs->timeStepConverged) return;


  auto &fluid = nrs->fluid;
  auto &mhdIndless = nrs->mhdIndless;
  auto mesh = fluid->mesh;
  dfloat gamma_r = 1.0;
  platform->par->extract("casedata", "gamma_r", gamma_r);

  poolDeviceMemory<dfloat> o_vy2(mesh->Nlocal);
  platform->linAlg->axmyz(
      mesh->Nlocal,
      1.0,
      fluid->o_U + 1*fluid->fieldOffset,
      fluid->o_U + 1*fluid->fieldOffset,
      o_vy2);
  dfloat vy2 =
      platform->linAlg->innerProd(
          mesh->Nlocal,
          o_vy2,
          mesh->o_Jw,
          platform->comm.mpiComm(),
          0) / mesh->volume;
  if (vy2 >= 0.0) vy2 = sqrt(vy2);

  dfloat vy2r = vy2/vy_0;
  dfloat vy2l = vy2/vy_last;
  dfloat gr = log(vy2r)/(time-time_start);
  dfloat gl = log(vy2l)/nrs->dt[0];
  dfloat ge = abs(gr - gamma_r)/gamma_r;
  dfloat gle = abs(gl - gamma_r)/gamma_r;

  if (platform->comm.mpiRank() == 0) {
  std::cout << "tstep=" << tstep
            << " time=" << time
            << " vy2=" << vy2
            << " gl=" << gl
            << " gr=" << gr
            << " gle=" << gle
            << " ge=" << ge
            << " AMP"
            << std::endl;
  }
  if (tstep < 200) {
      vy_0 = vy2;
      time_start = time;
  }
  vy_last = vy2;



  if (tstep < 200) {
    nrs->copyToNek(time, tstep);
    nek::userchk();
    nrs->copyFromNek(time);
  }
}

