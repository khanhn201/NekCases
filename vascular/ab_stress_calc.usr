c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
C
      qvol   = 0.0
      source = 0.0
      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'

      character*256 filename(10000)

      real vss(lx1,ly1,lz1,lelt)
      real vns(lx1,ly1,lz1,lelt)
      integer iwk, i

      ifpsco(1)=.true.
      ifto = .true.
      ifxyo = .true.

      if (nid.eq.0) then
         open(unit=199,
     $        file='file.list',
     $        form='formatted',
     $        status='old',
     $        iostat=ios)

         if (ios.ne.0) then
            write(6,*) 'ERROR: cannot open file.list'
            call exitt
         endif

         read(199,*,iostat=ios) nfiles

         if (ios.ne.0) then
            write(6,*) 'ERROR: cannot read number of files'
            close(199)
            call exitt
         endif

         if (nfiles.gt.10000) then
            write(6,*) 'ERROR: too many files:',nfiles
            close(199)
            call exitt
         endif

         do i=1,nfiles
            read(199,'(A256)',iostat=ios) filename(i)

            if (ios.ne.0) then
               write(6,*) 'ERROR reading file.list, file:',i
               close(199)
               call exitt
            endif
         enddo

         close(199)

      endif

      call igop ( nfiles , iwk , '+  ', 1 )
            write(6,*) nfiles

      call bcast(filename,nfiles*256)

      do i=1,nfiles
         if (nid.eq.0) then
            write(6,*) ' '
            write(6,*) '======================================'
            write(6,*) 'Processing file ',i,' / ',nfiles
            write(6,'(A)') trim(filename(i))
            write(6,*) '======================================'
         endif

         call load_fld(filename(i))
         istep = i

         call visc_strs(vss, vns, 'W  ')
         call outpost(vx,vy,vz,pr,vss,'vss')
         if (nid.eq.0) then
            write(6,*) 'vss written for file ',i
         endif

      enddo

      call exitt

      return
      end
c-----------------------------------------------------------------------
