[GENERAL]
numSteps = 500000
dt = 1e-4
# timeStepper = tombo2
writeInterval = 1000

filtering = hpfrt
filterModes = 2
filterWeight = 10.0

[PROBLEMTYPE]
# equation = navierStokes+variableViscosity
variableProperties = yes
stressFormulation = yes

[PRESSURE]
residualTol = 1e-6
residualProj = yes

[VELOCITY]
residualTol = 1e-8
density = 1.0
viscosity = -250

[TEMPERATURE]
solver = none
