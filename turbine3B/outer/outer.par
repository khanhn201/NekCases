[GENERAL]
polynomialOrder = 7
#startFrom = "restart.fld"
numSteps = 1000
dt = 5e-4
timeStepper = tombo2
writeInterval = 10
udf = "../turbine.udf"
#startFrom = "./outer0.f00020"

regularization = hpfrt + nModes=1 + scalingCoeff=10

[NEKNEK]
boundaryEXTOrder = 1

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
residualTol = 1e-6
density = 1.0
viscosity = 1/500
boundaryTypeMap = interpolation, zeroGradient, codedFixedValue, zeroValue
solver=pcg+block

[MESH]
solver=user
file = "outer.re2"

[SCALAR00]
solver = none

[CASEDATA]
P_OMEGA = 0.0
