[GENERAL]
polynomialOrder = 7
#startFrom = "restart.fld"
numSteps = 30000
dt = 5e-6
timeStepper = tombo2
writeInterval = 1000
udf = "../turbine.udf"
#startFrom = "./innergeo.f00000"
startFrom = "./inner50000.f00000"

regularization = hpfrt + nModes=1 + scalingCoeff=10

[NEKNEK]
boundaryEXTOrder = 1

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
residualTol = 1e-6
density = 1.2
viscosity = 1/10000
boundaryTypeMap = interpolation, codedFixedValue
solver = pcg+block

[MESH]
solver=user
file = "inner.re2"

[SCALAR00]
solver = none

[CASEDATA]
P_OMEGA = 0.375
