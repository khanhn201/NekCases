c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      n = nx1*ny1*nz1*nelv

      ie = gllel(ieg)
      ux=0.0
      uy=0.0
      uz=-1.0
      temp=0

      return
      end
