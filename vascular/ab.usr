C=======================================================================
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'


      parameter (lt=lx1*ly1*lz1*lelt)


      integer e,eg,f

      n = lx1*ly1*lz1*nelt

      nface = 2*ldim

      do iel=1,nelt
         do iface = 1, nface
            if (cbc(iface,iel,1) .eq. 'v  ') then ! Graft
               cbc(iface,iel,1) = 'v  '
            endif
            if (cbc(iface,iel,1) .eq. 'int') then ! Left (45deg to graft)
               cbc(iface,iel,1) = 'W  '
            endif
            if (cbc(iface,iel,1) .eq. 'O  ') then ! Right (135deg to graft)
               cbc(iface,iel,1) = 'O  '
            endif
         enddo 
      enddo
      
      do iel=1,nelt
      do ifc=1,2*ndim
         if (cbc(ifc,iel,1) .eq. 'W  ') then
           boundaryID(ifc,iel) = 1
         endif
         if (cbc(ifc,iel,1) .eq. 'v  ') then
           boundaryID(ifc,iel) = 2
         endif
         if (cbc(ifc,iel,1) .eq. 'O  ') then
           boundaryID(ifc,iel) = 3
         endif
      enddo
      enddo


      return
      end
