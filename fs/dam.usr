c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates
      implicit none

      include 'SIZE'
      include 'TOTAL'

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr

      integer ntot,i, iface, iel
      real xx, yy
      real xlength

      common /fsparam/ eps,alpha,gamma_r,gamma_i
      real gamma_r,gamma_i, eps, alpha

      gamma_i =   -1.177455429168827
      gamma_r =    0.000052447145099
      eps = 1e-4
c     eps = 0.0
      alpha = 1.0


      ifld_cls = 2
      ifld_tls = 3
      ifld_clsr = 4
      ifld_tlsr = 5
      
      ntot = lx1*ly1*lz1*nelt

      xlength = 2*pi
      call rescale_x (xm1,0.0,xlength)
      do i=1,ntot
         xx   = xm1(i,1,1,1)
         yy   = ym1(i,1,1,1)
      enddo

      do iel=1,nelt
         do iface = 1, 2*ldim
            if (cbc(iface,iel,1) .eq. 'SYM') then
               cbc(iface,iel,1) = 'W  '
            endif
         enddo
      enddo

      call gen_pert_ic ! perturbation i.c.s

      return
      end
