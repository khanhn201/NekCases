c---------------------------------------------------------------------
      subroutine gen_pert_ic ! perturbation i.c.s
      include 'SIZE'
      include 'TOTAL'
      include 'ZPER'   ! nely

      common /ls_usr/ ifld_cls,ifld_clsr,
     $                ifld_tls,ifld_tlsr 
      integer ifld_cls,ifld_clsr
      integer ifld_tls,ifld_tlsr
      common /fsarray/ ub(lx1,ly1,lz1,lelt),vb(lx1,ly1,lz1,lelt)
      common /fstemp/ temp_ic(lx1,ly1,lz1,lelv,2)
      common /fspres/ pres_ic(lx1,ly1,lz1,lelt)
      real ub, vb
      real temp_ic, pres_ic

      common /scrns/ ur(ly1,100),ui(ly1,100),vr(ly1,100),vi(ly1,100)
      common /scruz/ wk(ly1,100)

      integer e,eg,ex,ey,ez
      real blasius

      common /fsparam/ eps,alpha,gamma_r,gamma_i
      real gamma_r, eps, epsamp, alpha
      real fsr, fsi

      common /dimen/ Re,We,Fr,Pg
      real Re, We, Fr, Pg

      real temp, heaviside, tempi
      real ubi, vbi

      fsr    =   -0.222195390880021
      fsi    =   -0.777804609119979

      nelx = 60
      nely = 30
      nelz = 1

      call rzero(ur,ly1*100)
      call rzero(ui,ly1*100)
      call rzero(vr,ly1*100)
      call rzero(vi,ly1*100)

      m = ny1*10 ! u2.txt has 10 elements in fluid domain
      if (nid.eq.0) then
         open(unit=98,file='u2.txt')
         do i=1,m
            read(98,*) ur(i,1),ui(i,1),vr(i,1),vi(i,1)
         enddo
         close(98)
      endif

      call gop ( ur , wk , '+  ', m ) ! gather over all procs
      call gop ( ui , wk , '+  ', m )
      call gop ( vr , wk , '+  ', m )
      call gop ( vi , wk , '+  ', m )


      n = nx1*ny1*nz1*nelv

      epsamp = eps*exp(gamma_r*time)

      do k=1,2
      do e=1,nelv
      do j=1,ny1
      do i=1,nx1
         x  = xm1(i,j,1,e)
         y  = ym1(i,j,1,e)
         ax = alpha*x + gamma_i*time

         c  = cos(ax)
         s  = sin(ax)
         eg = lglel(e)

         call get_exyz(ex,ey,ez,eg,nelx,nely,nelz)

         ! Initiallize levelset
         disp = fsr*cos(ax) - fsi*sin(ax)
         h_local = epsamp*disp

         temp = h_local - y
         if ((k.eq.1).or.(k.eq.3)) then
           temp = heaviside(i,j,1,e,temp,0.0)
         endif
         temp_ic(i,j,1,e,k) = temp

         ! Initiallize velocity
         if (ey.le.10) then
           ub(i,j,1,e) = epsamp*(ur(j,ey)*c - ui(j,ey)*s)
           vb(i,j,1,e) = epsamp*(vr(j,ey)*c - vi(j,ey)*s)
           ubase = 1.0-y*y
           ub(i,j,1,e) = ub(i,j,1,e) + ubase
c        elseif (ey.le.20) then
c          ub(i,j,1,e)=epsamp*(ur(ny1+1-j,21-ey)*c
c    $                   -ui(ny1+1-j,21-ey)*s)
c          vb(i,j,1,e)=epsamp*(vr(ny1+1-j,21-ey)*c
c    $                   -vi(ny1+1-j,21-ey)*s)
c          ubase = 1.0
c          ub(i,j,1,e) = ub(i,j,1,e) + ubase
         else
           ubi = epsamp*(ur(m,1)*c - ui(m,1)*s)
           vbi = epsamp*(vr(m,1)*c - vi(m,1)*s)

           ub(i,j,1,e) = ubi - blasius(y-h_local, 10.0,ubi)
           vb(i,j,1,e) = vbi - blasius(y-h_local, 10.0,vbi)
           ubase = 1.0
           ub(i,j,1,e) = ub(i,j,1,e) + ubase
         endif

         if ((h_local - y).ge.0.0) then
            pres_ic(i,j,1,e) = (h_local - y)*(Re*Pg)**(-2)
         else
            pres_ic(i,j,1,e) = 0.0
         endif


      enddo
      enddo
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
      subroutine spline(x,y,n,y2)
      parameter (nmax=100)
      dimension x(n),y(n),y2(n),u(nmax)
      if (n.gt.nmax) then
         write(6,11) n,nmax
   11    FORMAT(2X,'ERROR:  Attempt to fit a spline with',I5
     $            ,'greater than',I4,' points.'
     $       ,/,2X,'Recompile routine SPLINE.')
         call exitti('routine spline fail$',n)
      endif
      y2(1)=0.0
      u(1) =0.0
      do 10 i=2,n-1
         ir=i+1
         il=i-1
         sig=(x(i)-x(il))/(x(ir)-x(il))
         p=sig*y2(il)+2.
         y2(i)=(sig-1.)/p
         u(i)= ( 6.*
     $     ( (y(ir)-y(i))/(x(ir)-x(i))-(y(i)-y(il))/ (x(i)-x(il) ) )
     $            / (x(ir)-x(il))
     $    - sig*u(il) )/p
   10 continue
      qn=0.0
      un=0.0
      y2(n)=(un-qn*u(n-1))/(qn*y2(n-1)+1.)
      do 20 k=n-1,1,-1
         y2(k)=y2(k)*y2(k+1)+u(k)
   20 continue
      return
      end
c-----------------------------------------------------------------------
      subroutine splint(xa,ya,y2a,n,x,y)
c     p. 88-89, numerical recipes
      real xa(n),ya(n),y2a(n)
      klo=1
      khi=n
    1   if ((khi-klo).gt.1) then
           k=(khi+klo)/2
           if (xa(k).gt.x) then
              khi=k
           else
              klo=k
           endif
           goto 1
        endif
      h=xa(khi)-xa(klo)
      if (h.eq.0) then
         write(6,*) xa(khi), 'splint failure',khi
         return
      endif
      a=(xa(khi)-x)/h
      b=(x-xa(klo))/h
      y=a*ya(klo)+b*ya(khi)+
     $  ((a**3-a)*y2a(klo)+(b**3-b)*y2a(khi))*(h**2)/6.
      return
      end
c-----------------------------------------------------------------------
      function blasius(y,delta,u)
c     Return the velocity at a given y value for specified delta and U.
      integer icalld
      save    icalld
      data    icalld /0/
      dimension u0(45),y0(45),work(45)
      save      u0    ,y0    ,work
      data      u0 / 0.00000 , 0.06641 , 0.13277 , 0.19894 , 0.26471
     $             , 0.32979 , 0.39378 , 0.45627 , 0.51676 , 0.57477
     $             , 0.62977 , 0.68132 , 0.72899 , 0.77246 , 0.81152
     $             , 0.84605 , 0.87609 , 0.90177 , 0.92333 , 0.94112
     $             , 0.95552 , 0.96696 , 0.97587 , 0.98269 , 0.98779
     $             , 0.99155 , 0.99425 , 0.99616 , 0.99748 , 0.99838
     $             , 0.99898 , 0.99937 , 0.99961 , 0.99977 , 0.99987
     $             , 0.99992 , 0.99996 , 0.99998 , 0.99999 , 1.00000
     $             , 1.00000 , 1.00000 , 1.00000 , 1.00000 , 1.00000 /
      if (icalld.eq.0) then
c        Initialize Blasius profile and spline fitting routine.
         icalld=1
         do 10 i=1,45
            y0(i)=float(i-1)/5.0
   10    continue
         call spline(y0,u0,45,work)
      endif
      eta=5.0*y/delta
      if (eta.gt.8.5) then
         blasius=u
      else
         call splint(y0,u0,work,45,eta,vel)
         blasius=vel*u
      endif
      return
      end
