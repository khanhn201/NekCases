[GENERAL]
numSteps = 50000
dt = 2e-4
# timeStepper = tombo2
writeInterval = 50

filtering = hpfrt
filterModes = 2
filterWeight = 10.0

[PROBLEMTYPE]
# equation = navierStokes+variableViscosity
# variableProperties = yes

[PRESSURE]
residualTol = 1e-8

[VELOCITY]
residualTol = 1e-8
density = 1.0
viscosity = 4/500

[TEMPERATURE]
solver = none
