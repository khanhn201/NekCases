void UDF_ExecuteStep(double time, int tstep)
{
  auto mesh = nrs->meshV;


  if (tstep > 1000 && tstep < 1009) {
    // Perturn vy
    const dfloat scale = 0.01;

    auto o_UX = nrs->fluid->o_U + 0 * nrs->fluid->fieldOffset;
    auto o_UY = nrs->fluid->o_U + 1 * nrs->fluid->fieldOffset;

    deviceMemory<dfloat> o_tmp;
    o_tmp.resize(mesh->Nlocal);
    
    platform->linAlg->axpbyz(mesh->Nlocal, 1.0, o_tmp, 1.0, o_UX, o_tmp); // o_tmp = VX
    platform->linAlg->add(mesh->Nlocal, -1.0, o_tmp);               // o_tmp = VX -1.0
    platform->linAlg->axpby(mesh->Nlocal, 0.01, o_tmp, 1.0, o_UY); // VY += 0.01 * tmp
  }
  if (nrs->checkpointStep) {
    nrs->copyToNek(time, tstep);
    nek::userchk(); // compute lambda2
    nrs->copyFromNek(time);
  }

 
}
