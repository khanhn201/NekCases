userSections = CASEDATA

[GENERAL]
polynomialOrder = 9
timeStepper = tombo3
dt = 1e-3
numSteps = 2000
checkpointInterval = 100

[FLUID PRESSURE]
residualTol = 1e-6
initialGuess = projectionAconj+nVector=10
smootherType = JAC+Chebyshev

[FLUID VELOCITY]
boundaryTypeMap = w
density = 1.0
residualTol = 1e-8
initialGuess = projectionAconj+nVector=10
viscosity = 1.2500e-04


[MHD INDUCTIONLESS]
boundaryTypeMap = I
mesh = fluid+solid

sigma = 0.028125
sigmaSolid = 0.2812

bx = 0.0
by = 1.0
bz = 0.0

# pMGSchedule = p=7+degree=3,p=5+degree=3,p=3+degree=3,p=1,p=3+degree=3,p=5+degree=3,p=7+degree=3
smootherType = jacobi + FourthOptChebyshev
coarseGridDiscretization = fem+galerkin


[CASEDATA]
iochk = 100
fz = 0.014328
gamma_r = 2.9392e-03
