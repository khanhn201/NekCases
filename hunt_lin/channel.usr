C

C  USER SPECIFIED ROUTINES: 
C
C     - boundary conditions 
C     - initial conditions  
C     - variable properties 
C     - forcing function for fluid (f)
C     - forcing function for passive scalar (q)
C     - general purpose routine for checking errors etc.        
C
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'

      common /initu/   ub(lx1,ly1,lz1,lelt),vb(lx1,ly1,lz1,lelt),
     $                 wb(lx1,ly1,lz1,lelt),phib(lx1,ly1,lz1,lelt) 
      real ub, vb, wb, phib

      
      ntot = lx1*ly1*lz1*nelv

      ! Initialize with IC
      call gen_pert_ic
      call copy(vx(1,1,1,1),ub(1,1,1,1),ntot)
      call copy(vy(1,1,1,1),vb(1,1,1,1),ntot)
      call copy(vz(1,1,1,1),wb(1,1,1,1),ntot)
      call copy(t(1,1,1,1,1),phib(1,1,1,1),ntot)

      return
      end
cc-----------------------------------------------------------------------
      subroutine usrdat   ! This routine to modify element vertices
      include 'SIZE'      ! _before_ mesh is generated, which 
      include 'TOTAL'     ! guarantees GLL mapping of mesh.

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates                                      

      include 'SIZE'
      include 'TOTAL'

      integer e,f

      alpha = 0.8
      zlength = 2*pi/alpha
      call rescale_x (zm1,0.0,zlength)

c     call rotate_axis_z_to_x
      call my_cbc_chk('aaa')

      do e=1,nelv
      do f=1,2*ndim
        if (cbc(f,e,1) .eq. 'v01') boundaryID(f,e) = 1 ! z side wall
        if (cbc(f,e,1) .eq. 'v02') boundaryID(f,e) = 1 ! z
        if (cbc(f,e,1) .eq. 'v03') boundaryID(f,e) = 2 ! y hartmann
        if (cbc(f,e,1) .eq. 'v04') boundaryID(f,e) = 2 ! y
      enddo
      enddo

      do e=1,nelt
      do f=1,2*ndim
        if (cbc(f,e,3) .eq. 'v01') boundaryIDt(f,e) = 1 ! z
        if (cbc(f,e,3) .eq. 'v02') boundaryIDt(f,e) = 1 ! z
        if (cbc(f,e,3) .eq. 'v03') boundaryIDt(f,e) = 2 ! y
        if (cbc(f,e,3) .eq. 'v04') boundaryIDt(f,e) = 2 ! y
      enddo
      enddo
      call my_cbc_chk('bbb')
    
      return
      end
cc-----------------------------------------------------------------------
      subroutine usrdat3
      include 'SIZE'
      include 'TOTAL'

      return
      end
cc-----------------------------------------------------------------------
      subroutine my_cbc_chk(s3)
c     This print types of current BC, counting as well
      implicit none
      include 'SIZE'
      include 'TOTAL'

      integer ncbc,lcbc,i,j,e,f,inid,mtype,idummy,ncbc_tmp,ifld,nel
     $      , nfldt
      parameter (lcbc=10) ! max # unique CBC
      integer cbc_count(lcbc),cbc_count_tmp(lcbc)
      character*3 cbc_list(lcbc),cbc_list_tmp(lcbc),cbc3,s3,tag3
      character*2 s2tmp
      logical cbc_in_list

      nfldt = nfield
      do ifld=0,nfldt

        if (ifld.eq.0) then
          tag3='PR '
          nel = nelv
        elseif (ifld.eq.1) then
          tag3='VEL'
          nel = nelv
        elseif (ifld.gt.1) then
          write(s2tmp,'(I2.2)') ifld-2
          tag3='S'//s2tmp
          nel = nelt
        endif

        call izero(cbc_count,lcbc)

        ncbc = 1                 ! # unique CBC
        cbc_list(1) = 'E  ' ! internal BC

        do e=1,nel
        do f=1,2*ldim
          cbc3 = cbc(f,e,ifld)
          cbc_in_list = .false.

          if (cbc3.eq.'E  '.or.cbc3.eq.'   ') then
            cbc_count(1) = cbc_count(1) + 1
            cbc_in_list = .true.
          else
            do i=2,ncbc ! go throught the registered CBC
              if (cbc3.eq.cbc_list(i)) then
                cbc_count(i) = cbc_count(i) + 1
                cbc_in_list = .true.
              endif
            enddo
          endif
          if (.not.cbc_in_list) then
            ncbc = ncbc + 1
            if (ncbc.gt.lcbc)
     $        call exitti('BCchk: Increase lcbc$',ncbc)

            cbc_list(ncbc) = cbc3
            cbc_count(ncbc) = 1
          endif
        enddo
        enddo

        call nekgsync()

        ! All reduce to nid=0
        if (nid.eq.0) then
          do inid=1,np-1
            mtype = inid
            call csend(mtype,idummy,4,inid,0) ! handshake

            call crecv(mtype,ncbc_tmp,4)
            call crecv(mtype,cbc_list_tmp(1),3*ncbc_tmp,0,0)
            call crecv(mtype,cbc_count_tmp(1),4*ncbc_tmp,0,0)

            cbc_count(1) = cbc_count(1)+cbc_count_tmp(1)
            do j=2,ncbc_tmp
              cbc_in_list = .false.
              do i=2,ncbc
                if (cbc_list(i).eq.cbc_list_tmp(j)) then
                  cbc_count(i) = cbc_count(i) + cbc_count_tmp(j)
                  cbc_in_list = .true.
                endif
              enddo
              if (.not.cbc_in_list) then
                ncbc = ncbc + 1
                if (ncbc.gt.lcbc)
     $            call exitti('BCchk: Increase lcbc$',ncbc)

                cbc_list(ncbc) = cbc_list_tmp(j)
                cbc_count(ncbc) = cbc_count_tmp(j)
              endif
            enddo
          enddo
        else
          mtype = nid
          call crecv(mtype,idummy,4) ! ! handshake

          call csend(mtype,ncbc,4,0,0)
          call csend(mtype,cbc_list,3*ncbc,0,0)
          call csend(mtype,cbc_count,4*ncbc,0,0)
        endif

        call nekgsync()

        ! print
        if (nid.eq.0) then
          do i=1,ncbc
            write(6,41) s3,ifld,tag3,cbc_list(i),cbc_count(i)
          enddo
        endif

      enddo ! ifld

      ifld = 3
      if (ifmhd.AND.ifld.eq.ifldmhd) then
        tag3='MHD'
        nel = nelv
      call izero(cbc_count,lcbc)

      ncbc = 1                 ! # unique CBC
      cbc_list(1) = 'E  ' ! internal BC

      do e=1,nel
      do f=1,2*ldim
        cbc3 = cbc(f,e,ifld)
        cbc_in_list = .false.

        if (cbc3.eq.'E  '.or.cbc3.eq.'   ') then
          cbc_count(1) = cbc_count(1) + 1
          cbc_in_list = .true.
        else
          do i=2,ncbc ! go throught the registered CBC
            if (cbc3.eq.cbc_list(i)) then
              cbc_count(i) = cbc_count(i) + 1
              cbc_in_list = .true.
            endif
          enddo
        endif
        if (.not.cbc_in_list) then
          ncbc = ncbc + 1
          if (ncbc.gt.lcbc)
     $      call exitti('BCchk: Increase lcbc$',ncbc)

          cbc_list(ncbc) = cbc3
          cbc_count(ncbc) = 1
        endif
      enddo
      enddo

      call nekgsync()

      ! All reduce to nid=0
      if (nid.eq.0) then
        do inid=1,np-1
          mtype = inid
          call csend(mtype,idummy,4,inid,0) ! handshake

          call crecv(mtype,ncbc_tmp,4)
          call crecv(mtype,cbc_list_tmp(1),3*ncbc_tmp,0,0)
          call crecv(mtype,cbc_count_tmp(1),4*ncbc_tmp,0,0)

          cbc_count(1) = cbc_count(1)+cbc_count_tmp(1)
          do j=2,ncbc_tmp
            cbc_in_list = .false.
            do i=2,ncbc
              if (cbc_list(i).eq.cbc_list_tmp(j)) then
                cbc_count(i) = cbc_count(i) + cbc_count_tmp(j)
                cbc_in_list = .true.
              endif
            enddo
            if (.not.cbc_in_list) then
              ncbc = ncbc + 1
              if (ncbc.gt.lcbc)
     $          call exitti('BCchk: Increase lcbc$',ncbc)

              cbc_list(ncbc) = cbc_list_tmp(j)
              cbc_count(ncbc) = cbc_count_tmp(j)
            endif
          enddo
        enddo
      else
        mtype = nid
        call crecv(mtype,idummy,4) ! ! handshake

        call csend(mtype,ncbc,4,0,0)
        call csend(mtype,cbc_list,3*ncbc,0,0)
        call csend(mtype,cbc_count,4*ncbc,0,0)
      endif

      call nekgsync()

      ! print
      if (nid.eq.0) then
        do i=1,ncbc
          write(6,41) s3,ifld,tag3,cbc_list(i),cbc_count(i)
        enddo
      endif

      endif

   41 format(a3,' BC: 'i3,' ',a3,a5,i10)

      return
      end
c-----------------------------------------------------------------------
      subroutine rotate_axis_z_to_x
      ! the mesh was extruded along z, here we rotate it to x
      implicit none
      include 'SIZE'
      include 'GEOM'

      real xo(lx1,ly1,lz1,lelt)
      real zo(lx1,ly1,lz1,lelt)
      integer n

      n = lx1*ly1*lz1*nelt
      call copy(xo,xm1,n)
      call copy(zo,zm1,n)

      call copy(zm1,xo,n)
      call chsign(zm1,n)
      call copy(xm1,zo,n)

      call fix_geom

      return
      end
c----------------------------------------------------------------------- 
      subroutine gen_pert_ic ! perturbation i.c.s
      include 'SIZE'
      include 'TOTAL'

      common /scrns/ ur(lx1,ly1,1000)  , ui(lx1,ly1,1000)  ,
     $               vr(lx1,ly1,1000)  , vi(lx1,ly1,1000)  ,
     $               wr(lx1,ly1,1000)  , wi(lx1,ly1,1000)  ,
     $               phir(lx1,ly1,1000), phii(lx1,ly1,1000)
      real ur, ui, vr, vi, wr, wi, phir, phii


      common /scruz/ wk(lx1,ly1,1000)
      real wk
      integer iwk

      common /initu/   ub(lx1,ly1,lz1,lelt),vb(lx1,ly1,lz1,lelt),
     $                 wb(lx1,ly1,lz1,lelt),phib(lx1,ly1,lz1,lelt) 
      real ub, vb, wb, phib

      common /baseu/   ubase(lx1,ly1,1000),
     $                 phibase(lx1,ly1,1000) 
      real ubase, phibase

      real facc, Byy

      real epsamp, eps, alpha, gamma_r, gamma_i

      integer e,eg,ex,ey,ez,nelxy,nelz,m,i,j,k,n
      real x, y, z, c, s

      real rho, mu, sigma

      eps = 1e-5
      nelz = 24

      call rzero(ur,ly1*ly1*1000)
      call rzero(ui,ly1*ly1*1000)
      call rzero(vr,ly1*ly1*1000)
      call rzero(vi,ly1*ly1*1000)

      if (nid.eq.0) then
         open(unit=98,file='u2.txt')
         read(98,*) nelxy
         read(98,*) rho, mu, sigma
         read(98,*) facc, Byy
         read(98,*) alpha
         read(98,*) gamma_r, gamma_i
         m = nx1*ny1*nelxy*nelxy
         do i=1,m
            read(98,*) ur(i,1,1),ui(i,1,1),vr(i,1,1),vi(i,1,1),
     $                 wr(i,1,1),wi(i,1,1),phir(i,1,1),phii(i,1,1)

         enddo
         close(98)

         open(unit=98,file='ubase.txt')
         read(98,*) nelxy
         read(98,*) rho, mu, sigma
         read(98,*) facc, Byy
         read(98,*) alpha
         read(98,*) gamma_r, gamma_i
         m = nx1*ny1*nelxy*nelxy
         do i=1,m
            read(98,*) ubase(i,1,1),phibase(i,1,1)

         enddo
         close(98)
      else
         nelxy = 0
         m = 0
      endif

      call igop ( nelxy , iwk , '+  ', 1 )
      call igop ( m , iwk , '+  ', 1 )
      call gop ( ur , wk , '+  ', m )  ! gather over all procs
      call gop ( ui , wk , '+  ', m )
      call gop ( vr , wk , '+  ', m )
      call gop ( vi , wk , '+  ', m )
      call gop ( wr , wk , '+  ', m )
      call gop ( wi , wk , '+  ', m )
      call gop ( phir , wk , '+  ', m )
      call gop ( phii , wk , '+  ', m )
      call gop ( ubase , wk , '+  ', m )
      call gop ( phibase , wk , '+  ', m )

      n = nx1*ny1*nz1*nelv

      epsamp = eps*exp(gamma_r*time)

      do e=1,nelv
      do k=1,nz1
      do j=1,ny1
      do i=1,nx1
         x  = xm1(i,j,k,e)
         y  = ym1(i,j,k,e)
         z  = zm1(i,j,k,e)
         az = alpha*z + gamma_i*time

         c  = cos(az)
         s  = sin(az)
         eg = lglel(e)

         ! Velocity initialization
         call get_exyz(ex,ey,ez,eg,nelxy,nelxy,nelz)
         exy = ex + (ey-1)*nelxy
         ub(i,j,k,e) = epsamp*(ur(i,j,exy)*c - ui(i,j,exy)*s)
         vb(i,j,k,e) = epsamp*(vr(i,j,exy)*c - vi(i,j,exy)*s)
         wb(i,j,k,e) = epsamp*(wr(i,j,exy)*c - wi(i,j,exy)*s)
         phib(i,j,k,e) = epsamp*(phir(i,j,exy)*c - phii(i,j,exy)*s)

         wb(i,j,k,e) = wb(i,j,k,e) + ubase(i,j,exy)
         phib(i,j,k,e) = phib(i,j,k,e) + phibase(i,j,exy)
      enddo
      enddo
      enddo
      enddo

      return
      end
c---------------------------------------------------------------------
