C

C  USER SPECIFIED ROUTINES: 
C
C     - boundary conditions 
C     - initial conditions  
C     - variable properties 
C     - forcing function for fluid (f)
C     - forcing function for passive scalar (q)
C     - general purpose routine for checking errors etc.        
C
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'

      common /initu/   ub(lx1,ly1,lz1,lelv),vb(lx1,ly1,lz1,lelv),
     $                 wb(lx1,ly1,lz1,lelv),phib(lx1,ly1,lz1,lelv) 
      real ub, vb, wb, phib

      
      ntot = lx1*ly1*lz1*nelv

      ! Initialize with IC
      call gen_pert_ic
      call copy(vx(1,1,1,1),ub(1,1,1,1),ntot)
      call copy(vy(1,1,1,1),vb(1,1,1,1),ntot)
      call copy(vz(1,1,1,1),wb(1,1,1,1),ntot)
c     call copy(t(1,1,1,1,1),phib(1,1,1,1),ntot)

      return
      end
cc-----------------------------------------------------------------------
      subroutine usrdat   ! This routine to modify element vertices
      include 'SIZE'      ! _before_ mesh is generated, which 
      include 'TOTAL'     ! guarantees GLL mapping of mesh.

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates                                      

      include 'SIZE'
      include 'TOTAL'

      integer e,f
      real alpha, wk

      alpha = 0.0
      if (nid.eq.0) then
         open(unit=98,file='u2.txt')
         read(98,*)
         read(98,*)
         read(98,*)
         read(98,*) alpha
         close(98)
      endif
      call gop ( alpha ,  wk , '+  ', 1 )

      zlength = 2*pi/alpha
      call rescale_x (zm1,0.0,zlength)

      do e=1,nelv
      do f=1,2*ndim
        if (cbc(f,e,1) .eq. 'v01') boundaryID(f,e) = 1 ! z side wall
        if (cbc(f,e,1) .eq. 'v02') boundaryID(f,e) = 1 ! z
        if (cbc(f,e,1) .eq. 'v03') boundaryID(f,e) = 2 ! y hartmann
        if (cbc(f,e,1) .eq. 'v04') boundaryID(f,e) = 2 ! y
      enddo
      enddo

      do e=1,nelt
      do f=1,2*ndim
        if (cbc(f,e,3) .eq. 'v01') boundaryIDt(f,e) = 1 ! z
        if (cbc(f,e,3) .eq. 'v02') boundaryIDt(f,e) = 1 ! z
        if (cbc(f,e,3) .eq. 'v03') boundaryIDt(f,e) = 2 ! y
        if (cbc(f,e,3) .eq. 'v04') boundaryIDt(f,e) = 2 ! y
      enddo
      enddo
    
      return
      end
cc-----------------------------------------------------------------------
      subroutine usrdat3
      include 'SIZE'
      include 'TOTAL'

      return
      end
c----------------------------------------------------------------------- 
      subroutine gen_pert_ic ! perturbation i.c.s
      include 'SIZE'
      include 'TOTAL'

      common /peru/ ur(lx1,ly1,1000)  , ui(lx1,ly1,1000)  ,
     $               vr(lx1,ly1,1000)  , vi(lx1,ly1,1000)  ,
     $               wr(lx1,ly1,1000)  , wi(lx1,ly1,1000)  ,
     $               phir(lx1,ly1,1000), phii(lx1,ly1,1000)
      real ur, ui, vr, vi, wr, wi, phir, phii


      common /scruz/ wk(lx1,ly1,1000)
      real wk
      integer iwk

      common /initu/   ub(lx1,ly1,lz1,lelt),vb(lx1,ly1,lz1,lelt),
     $                 wb(lx1,ly1,lz1,lelt),phib(lx1,ly1,lz1,lelt) 
      real ub, vb, wb, phib

      common /baseu/   ubase(lx1,ly1,1000),
     $                 phibase(lx1,ly1,1000) 
      real ubase, phibase

      real facc, Byy

      real epsamp, eps, alpha, gamma_r, gamma_i

      integer e,eg,ex,ey,ez,nelxy,nelz,m,i,j,k,n
      real x, y, z, c, s

      real rho, mu, sigma

      eps = 1e-5
      nelz = 24

      call rzero(ur,ly1*ly1*1000)
      call rzero(ui,ly1*ly1*1000)
      call rzero(vr,ly1*ly1*1000)
      call rzero(vi,ly1*ly1*1000)

      nelxy = 0
      m = 0
      alpha = 0.0
      gamma_i = 0.0
      gamma_r = 0.0
      if (nid.eq.0) then
         open(unit=98,file='u2.txt')
         read(98,*) nelxy
         read(98,*) rho, mu, sigma
         read(98,*) facc, Byy
         read(98,*) alpha
         read(98,*) gamma_r, gamma_i
         m = nx1*ny1*nelxy*nelxy
         do i=1,m
            read(98,*) ur(i,1,1),ui(i,1,1),vr(i,1,1),vi(i,1,1),
     $                 wr(i,1,1),wi(i,1,1),phir(i,1,1),phii(i,1,1)

         enddo
         close(98)

         open(unit=98,file='ubase.txt')
         read(98,*) nelxy
         read(98,*) rho, mu, sigma
         read(98,*) facc, Byy
         read(98,*) alpha
         read(98,*) gamma_r, gamma_i
         m = nx1*ny1*nelxy*nelxy
         do i=1,m
            read(98,*) ubase(i,1,1),phibase(i,1,1)
         enddo
         close(98)
      endif

      call igop ( nelxy , iwk , '+  ', 1 )
      call igop ( m , iwk , '+  ', 1 )
      call gop ( alpha ,  wk , '+  ', 1 )
      call gop ( gamma_i ,  wk , '+  ', 1 )
      call gop ( gamma_r ,  wk , '+  ', 1 )
      call gop ( ur , wk , '+  ', m )  ! gather over all procs
      call gop ( ui , wk , '+  ', m )
      call gop ( vr , wk , '+  ', m )
      call gop ( vi , wk , '+  ', m )
      call gop ( wr , wk , '+  ', m )
      call gop ( wi , wk , '+  ', m )
      call gop ( phir , wk , '+  ', m )
      call gop ( phii , wk , '+  ', m )
      call gop ( ubase , wk , '+  ', m )
      call gop ( phibase , wk , '+  ', m )

      n = nx1*ny1*nz1*nelv

      epsamp = eps*exp(gamma_r*time)

      do e=1,nelv
      do k=1,nz1
      do j=1,ny1
      do i=1,nx1
         x  = xm1(i,j,k,e)
         y  = ym1(i,j,k,e)
         z  = zm1(i,j,k,e)
         az = alpha*z + gamma_i*time

         c  = cos(az)
         s  = sin(az)
         eg = lglel(e)

         ! Velocity initialization
         call get_exyz(ex,ey,ez,eg,nelxy,nelxy,nelz)
         exy = ex + (ey-1)*nelxy
         ub(i,j,k,e) = epsamp*(ur(i,j,exy)*c - ui(i,j,exy)*s)
         vb(i,j,k,e) = epsamp*(vr(i,j,exy)*c - vi(i,j,exy)*s)
         wb(i,j,k,e) = epsamp*(wr(i,j,exy)*c - wi(i,j,exy)*s)
c        phib(i,j,k,e) = epsamp*(phir(i,j,exy)*c - phii(i,j,exy)*s)

         wb(i,j,k,e) = wb(i,j,k,e) + ubase(i,j,exy)
c        phib(i,j,k,e) = phib(i,j,k,e) + phibase(i,j,exy)
      enddo
      enddo
      enddo
      enddo

      return
      end
c---------------------------------------------------------------------
