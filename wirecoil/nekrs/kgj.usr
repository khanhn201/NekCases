c-----------------------------------------------------------------------
      subroutine usrdat2
    
      include 'SIZE'
      include 'TOTAL'
      integer e,f
      parameter (lt=lx1*ly1*lz1*lelt)
      common /mystuff/ ox(lt),oy(lt),oz(lt)

c    D=0.375; R=D/2; e=0.25*D; rw = e/2;
c    
c    p = 1/6;  % 6 turns per inch

      n = nx1*ny1*nz1*nelt

c     compute P/D based on experimental values, epitch & ediam:
      epitch = 1.
      epitch = epitch/6.
      ediam  = 0.375
      pd     = epitch/ediam

      z0  = 0
      z1  = 2*pd
      call rescale_x(zm1,z0,z1)

      do i=1,n
         x=xm1(i,1,1,1)
         y=ym1(i,1,1,1)
         z=zm1(i,1,1,1)
         phi = 4*pi*z/z1
         rad = x*x+y*y
         if (rad.gt.0) then
            rad   = sqrt(rad)
            theta = atan2(y,x)
            xm1(i,1,1,1) = rad*cos(theta+phi)
            ym1(i,1,1,1) = rad*sin(theta+phi)
         endif
      enddo

      call fix_geom

      do iel=1,nelt
      do ifc=1,2*ndim
         if (cbc(ifc,iel,1) .eq. 'W  ') boundaryID(ifc,iel) = 1
         if (cbc(ifc,iel,1) .eq. 'v  ') boundaryID(ifc,iel) = 2
      enddo
      enddo
  
      do iel=1,nelt
      do ifc=1,2*ndim
         if (cbc(ifc,iel,2) .eq. 'f  ') boundaryIDt(ifc,iel) = 1
      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------
c
c      Thermal properties:
c
c
c      k   rho   Cp
c      ------------------------
c      385 8.9  .385  Copper
c     .608 1.0  4.18  water
c
c
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      udiff  = 0    ! Not used -- the actual per-element fluid/solid diffusivity
      utrans = 0    ! split is set on the GPU by kgj.udf's uservp(), not here.
                    ! material_props() (below) only sets GLOBAL Nek5000 scalars
                    ! (param(7)/param(8), rhocp_s/alpha_s) for the legacy CPU-side
                    ! volsource/tbar-weighting path -- it does NOT feed a per-element
                    ! array into NekRS's GPU scalar solve. A stale version of this
                    ! comment claiming otherwise was the root cause of a real bug:
                    ! the solid region silently conducted at the FLUID's diffusivity
                    ! until uservp() was added. See kgj-simulation-reference.md SS5.

      return
      end
c-----------------------------------------------------------------------
      subroutine userf  (ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer e,f,eg
c     e = gllel(eg)


c     Note: this is an acceleration term, NOT a force!
c     Thus, ffx will subsequently be multiplied by rho(x,t).


      ffx = 0.0
      ffy = 0.0
      ffz = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /cfluxa/  flux_area,gamma_t,cond_cu,prandtl,rhocp_s
      common /source/  volsource(lx1,ly1,lz1,lelt)
      common /myq1mx/  q1max,q2max

      integer e,f,eg

      e      = gllel(eg)

      qvol   = volsource(ix,iy,iz,e)

      if (eg.le.nelgv) then  ! In fluid domain
         rhocp  = param(7)
         qvol   = qvol-rhocp*gamma_t*vz(ix,iy,iz,e)
      endif

      if (istep.eq.3) then
         q1max=0
         q2max=0
      elseif (istep.eq.4) then
         q1max=max(q1max,abs(volsource(ix,iy,iz,e)))
         q2max=max(q2max,abs(rhocp*gamma_t*vz(ix,iy,iz,e)))
      elseif (istep.eq.5.and.ix*iy*iz*e.eq.1) then
         q1max=glamax(q1max,1)
         q2max=glamax(q2max,1)
         if (nio.eq.0) write(6,1) istep,time,q1max,q2max
    1    format(i9,1p3e18.9,' qmax')
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'

      common /source/  volsource(lx1,ly1,lz1,lelt)

      common /cfluxa/  flux_area,gamma_t,cond_cu,prandtl,rhocp_s
      common /pipec/ qsurf,r_in,r_out
      real nusselt,nuss_inv

      parameter (lt=lx1*ly1*lz1*lelt)
      common /scruz/ tx(lt),ty(lt),tz(lt),w(lt)
      integer e,f


      
      real rcpgamma_t(3)
      save rcpgamma_t

c     Per-snapshot physical diagnostics, exposed to kgj.udf via nekrs_registerPtr
c     for stage1's diagnostics.bin (see kgj-interpolation-pipeline/README.md).
c     Layout: [tbar, tbulk, tout, nusselt, flux_wall, flux_wire, flux_tot].
c     Filled below, right after each value is computed in this same routine.
c     kgj.udf calls nek::userchk() every snapshotInterval steps (not the old
c     1000-step throttle), so these are always fresh at the moment a snapshot
c     is written -- see kgj.udf's UDF_ExecuteStep.
      real diagScalars(7)
      save diagScalars

      nv = nx1*ny1*nz1*nelv
      nt = nx1*ny1*nz1*nelt

      call lambda2(t(1,1,1,1,2))
      
      rhocp = 1.0
      call nekrs_registerPtr('volsource', volsource)
      call nekrs_registerPtr('rcpgamma_t', rcpgamma_t)
      call nekrs_registerPtr('diagScalars', diagScalars)

      tbar = rhocp_weighted_average(t)
      diagScalars(1) = tbar

      if (istep.eq.0) then
         call set_flux_area       ! Area of flux surface
         call set_vol_flow_rate
         call cadd(t,-tbar,nt)    ! Set Tbar=0
      endif

      call set_volsource ! Variable diffusivity fix -- now runs every userchk call
                          ! (throttled to every 1000 steps from kgj.udf), not just istep<3

      uflx = glsc2(vz,bm1,nv)
      ubar = uflx/volvm1
      umax = glmax(vz,nv)

      qsurf     = 1.    ! Nominal flux at Inner Wall

      zlength   = glmax(zm1,nt)-glmin(zm1,nt)
      diam_i    = glmax(xm1,nv)-glmin(xm1,nv) ! Diameter of fluid domain
      diam_o    = glmax(xm1,nt)-glmin(xm1,nt) ! Diameter of whole domain

      r_in      = diam_i/2
      r_out     = diam_o/2

      rhocp     = param(7) ! fluid property
      cond      = param(8) ! = 1/Re/Pr, set in material_props from [FLUID VELOCITY]
                            ! viscosity -- do NOT hardcode this; a hardcoded
                            ! Re=5000 value here previously went stale silently
                            ! for any other Re (cond_cu/Nusselt only, did not
                            ! affect velocity/CFL).
      cond_cu  = cond*(385.0/0.608)            ! copper k / water k
      gamma_t   = flux_area*qsurf/(rhocp*uflx)

c     rcpgamma_t(1) now caches flux_area*qsurf/(rhocp*volvm1), NOT divided by uflx --
c     uz_flx_s (kgj.udf) is ubar=uflx/volvm1 (volume AVERAGE), not uflx (volume
c     INTEGRAL), so pre-dividing by volvm1 here makes fqr/uz_flx_s reconstruct
c     exactly flux_area*qsurf/(rhocp*uflx), matching the original gamma_t formula.
c     Missing this volvm1 factor was caught via direct tbar/tbulk comparison against
c     a non-throttled run at the same dt/constFlowRate (job 8571015 vs 8570738) --
c     see kgj-performance/userchk-throttle-attempt.md.
      fqr = flux_area*qsurf/(rhocp*volvm1)
      rcpgamma_t(1) = rhocp*fqr

      if (nid.eq.0) write(6,2)gamma_t,umax,ubar,flux_area,uflx,diam_i
    2 format(1p6e13.5,' gamma')

      tbulk = glsc3(vz,t,bm1,nv)/glsc2(vz,bm1,nv)
      diagScalars(2) = tbulk
      call surf_avg(tout ,a_suro,t,2,'f  ')  ! Avg. Temp on OUTSIDE Wall
      diagScalars(3) = tout

      nuss_inv = (cond/(diam_o*qsurf))*(tout-tbulk)    ! Formula based on
     $         - 0.5*(cond/cond_cu)*log(diam_o/diam_i) ! outer pipe diam.
      nusselt = 1./nuss_inv
      diagScalars(4) = nusselt

c     Below, we monitor flux through wire vs flux through wall:

      call gradm1(tx,ty,tz,t)

      flux_wall = 0                   ! INITIALIZE FLUX TALLIES
      area_wall = 0
      t_wall    = 0
      flux_wire = 0
      area_wire = 0
      t_wire    = 0
      n_wall    = 0
      n_wire    = 0

      do e=1,nelv                      ! LOCAL SUMS
      do f=1,2*ndim
         if (cbc(f,e,1).eq.'W  ') then
            call surface_flux(dq,tx,ty,tz,e,f,w)
            call surface_int(sint,sarea,t,e,f)
            flux_wall = flux_wall + cond*dq
            area_wall = area_wall + sarea
            t_wall    = t_wall    + sint
            n_wall    = n_wall    + 1
         elseif (cbc(f,e,1).eq.'v  ') then
            call surface_flux(dq,tx,ty,tz,e,f,w)
            call surface_int(sint,sarea,t,e,f)
            flux_wire = flux_wire + cond*dq
            area_wire = area_wire + sarea
            t_wire    = t_wire    + sint
            n_wire    = n_wire    + 1
         endif
      enddo
      enddo

      flux_wall = glsum(flux_wall,1)    ! SUM OVER ALL PROCESSORS
      flux_wire = glsum(flux_wire,1)
      flux_tot  = flux_wall + flux_wire
      diagScalars(5) = flux_wall
      diagScalars(6) = flux_wire
      diagScalars(7) = flux_tot
      area_wall = glsum(area_wall,1)
      area_wire = glsum(area_wire,1)
      n_wall    = iglsum(n_wall,1)
      n_wire    = iglsum(n_wire,1)

      t_wall    = glsum(t_wall   ,1) / area_wall
      t_wire    = glsum(t_wire   ,1) / area_wire

      if (nid.eq.0.and.istep.gt.0) 
     $   write(6,1) istep,time,tbar,tbulk,t_wire,t_wall,tout
    1 format(i6,1p6e12.4,' tbar')

      flux_nom = qsurf*flux_area
      if (nid.eq.0) write(6,3)
     $ istep,time,flux_wire,flux_wall,flux_tot,flux_nom,nusselt
    3 format(i8,1p6e13.5,' fluxes')


c     avg/rms/rm2 time-averaged turbulence statistics disabled (2026-06-28) --
c     not needed for the snapshot-based VAE+diffusion data pipeline, and was
c     writing ~314MB x3 every 6000 steps (param(68)), ballooning disk usage
c     independently of checkpointInterval. Re-enable by uncommenting below if
c     turbulence statistics are ever wanted for a separate analysis.
c     param(68) = 6000
c     call avg_all_t    ! Save <uT> instead of usual <uv> etc.

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      common /pipec/ qsurf,r_in,r_out

      ux=0.0
      uy=0.0
      uz=0.0
      temp=0.0

      flux = qsurf ! Flux on outer surface qsurf=1.0


      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e,eg


      ux  = 0
      uy  = 0
      uz  = 0

      rad = 0.5
      xr  = x/rad
      yr  = y/rad
      uz  = 2*( 1 -xr*xr - yr*yr)

      temp=0

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat
      include 'SIZE'
      include 'TOTAL'

      integer e,eg,f

c     ifuservp = .true.  ! Allow for variable conductivity, etc. 
c                        ! in the solid elements

      call material_props ! This assigns variable properties by groups (faster)


      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      include 'SIZE'
      include 'TOTAL'
c
      return
      end
c-----------------------------------------------------------------------
      subroutine set_flux_area

      include 'SIZE'
      include 'TOTAL'

      common /scruz/ one(lx1*ly1*lz1*lelt)
      common /cfluxa/  flux_area,gamma_t,cond_cu,prandtl,rhocp_s

      integer e,f

      n = nx1*ny1*nz1*nelt
      call rone(one,n)

      flux_area = 0
      do e=1,nelt
      do f=1,2*ndim
         if (cbc(f,e,2).eq.'f  ') then
            dflux_area=facint_v(one,area,f,e)
            flux_area=flux_area+dflux_area
         endif
      enddo
      enddo
      flux_area = glsum(flux_area,1)
      if (nid.eq.0) write(6,*) flux_area,' this is flux_area'

      return
      end
c-----------------------------------------------------------------------
      subroutine surf_avg(s_bar,a_surf,s,ifld,cb3)

      include 'SIZE'
      include 'TOTAL'

      real s(lx1,ly1,lz1,lelt)
      character*3 cb3

      integer e,f

      s_bar  = 0
      s_surf = 0
      a_surf = 0
      n_surf = 0

      do e=1,nelfld(ifld)
      do f=1,2*ndim
         if (cbc(f,e,ifld).eq.cb3) then
            call facint1(s1,a1,s,area,f,e) ! integrate a() on face f
            s_surf = s_surf + s1
            a_surf = a_surf + a1
            n_surf = n_surf + 1
         endif
      enddo
      enddo

      s_surf = glsum(s_surf,1)   ! sum across all processors
      a_surf = glsum(a_surf,1)
      n_surf = iglsum(n_surf,1)

      if (a_surf.gt.0) s_bar  = s_surf/a_surf

c     if (nid.eq.0) write(6,2) istep,n_surf,time,a_surf,s_surf,s_bar
c   2 format(2i9,1p4e12.4,' surf_avg')

      return
      end
c-----------------------------------------------------------------------
      subroutine facint1(s1,a1,s,area,f,e) ! integrate a() on face f

      include 'SIZE'
      include 'TOPOL'

      real s(lx1,ly1,lz1,lelv),area(lx1,lz1,6,lelv)

      integer e,f

      call dsset(nx1,ny1,nz1) !     Set up counters
      iface  = eface1(f)
      js1    = skpdat(1,iface)
      jf1    = skpdat(2,iface)
      jskip1 = skpdat(3,iface)
      js2    = skpdat(4,iface)
      jf2    = skpdat(5,iface)
      jskip2 = skpdat(6,iface)

      i =0
      s1=0
      a1=0
      do 100 j2=js2,jf2,jskip2
      do 100 j1=js1,jf1,jskip1
         i  = i+1
         s1 = s1 + area(i,1,f,e)*s(j1,j2,1,e)
         a1 = a1 + area(i,1,f,e)
  100 continue

      return
      end
c-----------------------------------------------------------------------
      subroutine material_props
      include 'SIZE'
      include 'TOTAL'
      common /cfluxa/  flux_area,gamma_t,cond_cu,prandtl,rhocp_s

      real cprop(3,2) !    k    rho    Cp
      save cprop      !   -----------------
      data cprop      /   385 , 8.9 , .385     ! copper
     $                ,  .608 , 1.0 , 4.18  /  ! water
   
      real ratio_conduct_cu_h2o,ratio_rhocp_cu_h2o
      save ratio_conduct_cu_h2o,ratio_rhocp_cu_h2o
      data ratio_conduct_cu_h2o,ratio_rhocp_cu_h2o / 0.,0./

      integer e,f,eg

      real nu

      !e = gllel(eg)

      if (ratio_conduct_cu_h2o.eq.0) then
         ratio_conduct_cu_h2o = cprop(1,1)/cprop(1,2)
         ratio_rhocp_cu_h2o   
     $       = cprop(2,1)*cprop(3,1)/(cprop(2,2)*cprop(3,2))
         if (nid.eq.0) 
     $   write(6,*) ratio_conduct_cu_h2o,ratio_rhocp_cu_h2o,' ratios'
      endif

c     prandtl = 1.000
      prandtl = 5.858              ! From Jeff's analysis

      param(1) = 1.
      param(7) = 1.

      rho      = param(1)          ! rho    := 1
      nu       = param(2)          ! kinematic viscosity = 1/Re

      rhocp    = param(7)          ! rhoCp  := 1 in fluid
      alpha    = param(2)/prandtl  ! diffusivity in fluid

      param(7) = rhocp
      param(8) = alpha

      rhocp_s  = rhocp*ratio_rhoCp_cu_h2o      ! Properties inside solid
      alpha_s  = alpha*ratio_conduct_cu_h2o


      return
      end
c-----------------------------------------------------------------------
      function rhocp_weighted_average(ti)

      include 'SIZE'
      include 'TOTAL'
      common /cfluxa/  flux_area,gamma_t,cond_cu,prandtl,rhocp_s

      real ti(lx1*ly1*lz1,lelt)
      integer e,f

      nxyz = nx1*ny1*nz1

      sum = 0
      den = 0

      do e=1,nelt
         rhocp = param(7)
         if (e.gt.nelv) rhocp = rhocp_s
         sum = sum + rhocp*vlsc2(bm1(1,1,1,e),ti(1,e),nxyz)
         den = den + rhocp*vlsum(bm1(1,1,1,e),nxyz)
      enddo

      rhocp_weighted_average = glsum(sum,1)/glsum(den,1)

      return
      end
c-----------------------------------------------------------------------
      subroutine set_vol_flow_rate

c     Choose Ubar=param(55) such that the volume flow rate is equal 
c     to that when Ubar=1 in the open (i.e., unobstructed) pipe.

      include 'SIZE'
      include 'TOTAL'

      integer e,f

      nv = nx1*ny1*nz1*nelv

      xmin = glmin(xm1,nv)
      xmax = glmax(xm1,nv)
      ymin = glmin(ym1,nv)
      ymax = glmax(ym1,nv)
      zmin = glmin(zm1,nv)
      zmax = glmax(zm1,nv)

      zlength = zmax-zmin
      diam_i  = 0.5*( (xmax-xmin) + (ymax-ymin) )
      rad_i   = 0.5*diam_i

      volume_pipe = pi*rad_i*rad_i*zlength

      area_ratio  = volume_pipe/volvm1 ! ratio of nominal to actual, > 1

      Ubar_nominal  = 1.
      Ubar_required = Ubar_nominal*area_ratio

      param(55) = Ubar_required

      if (nid.eq.0) write(6,1) ubar_required,volume_pipe,volvm1
    1 format(1p3e15.7,' target ubar, vol')

      return
      end
c-----------------------------------------------------------------------
      subroutine avg_all_t
c
c     This routine computes running averages E(X),E(X^2),E(X*Y)
c     and outputs to avg*.fld*, rms*.fld*, and rm2*.fld* for all
c     fields.
c
c     E denotes the expected value operator and X,Y two
c     real valued random variables.
c
c     variances and covariances can be computed in a post-processing step:
c
c        var(X)   := E(X^X) - E(X)*E(X) 
c        cov(X,Y) := E(X*Y) - E(X)*E(Y)  
c
c     Note: The E-operator is linear, in the sense that the expected
c           value is given by E(X) = 1/N * sum[ E(X)_i ], where E(X)_i
c           is the expected value of the sub-ensemble i (i=1...N).
c
      include 'SIZE'  
      include 'TOTAL' 
      include 'AVG'

      logical ifverbose
      integer icalld
      save    icalld
      data    icalld  /0/

      if (ax1.ne.lx1 .or. ay1.ne.ly1 .or. az1.ne.lz1) then
         if(nid.eq.0) write(6,*)
     $     'ABORT: wrong size of ax1,ay1,az1 in avg_all(), check SIZEu!'
         call exitt
      endif
      if (ax2.ne.lx2 .or. ay2.ne.ay2 .or. az2.ne.lz2) then
         if(nid.eq.0) write(6,*)
     $     'ABORT: wrong size of ax2,ay2,az2 in avg_all(), check SIZEu!'
         call exitt
      endif

      ntot  = nx1*ny1*nz1*nelv
      ntott = nx1*ny1*nz1*nelt
      nto2  = nx2*ny2*nz2*nelv

      ! initialization
      if (icalld.eq.0) then
         icalld = icalld + 1
         atime  = 0.
         timel  = time

         call rzero(uavg,ntot)
         call rzero(vavg,ntot)
         call rzero(wavg,ntot)
         call rzero(pavg,nto2)
         do i = 1,ldimt
            call rzero(tavg(1,1,1,1,i),ntott)
         enddo

         call rzero(urms,ntot)
         call rzero(vrms,ntot)
         call rzero(wrms,ntot)
         call rzero(prms,nto2)
         do i = 1,ldimt
            call rzero(trms(1,1,1,1,i),ntott)
         enddo

         call rzero(vwms,ntot)
         call rzero(wums,ntot)
         call rzero(uvms,ntot)
      endif

      dtime = time  - timel
      atime = atime + dtime

      ! dump freq
      iastep = param(68)
      if  (iastep.eq.0) iastep=param(15)   ! same as iostep
      if  (iastep.eq.0) iastep=500

      ifverbose=.false.
      if (istep.le.10) ifverbose=.true.
      if  (mod(istep,iastep).eq.0) ifverbose=.true.

      if (atime.ne.0..and.dtime.ne.0.) then
         if(nid.eq.0) write(6,*) 'Compute statistics ...'
         beta  = dtime/atime
         alpha = 1.-beta
         ! compute averages E(X)
         call avg1    (uavg,vx,alpha,beta,ntot ,'um  ',ifverbose)
         call avg1    (vavg,vy,alpha,beta,ntot ,'vm  ',ifverbose)
         call avg1    (wavg,vz,alpha,beta,ntot ,'wm  ',ifverbose)
         call avg1    (pavg,pr,alpha,beta,nto2 ,'prm ',ifverbose)
         call avg1    (tavg,t ,alpha,beta,ntott,'tm  ',ifverbose)
         do i = 2,ldimt
            call avg1 (tavg(1,1,1,1,i),t(1,1,1,1,i),alpha,beta,
     &                 ntott,'psav',ifverbose)
         enddo

         ! compute averages E(X^2) 
         call avg2    (urms,vx,alpha,beta,ntot ,'ums ',ifverbose)
         call avg2    (vrms,vy,alpha,beta,ntot ,'vms ',ifverbose)
         call avg2    (wrms,vz,alpha,beta,ntot ,'wms ',ifverbose)
         call avg2    (prms,pr,alpha,beta,nto2 ,'prms',ifverbose)
         call avg2    (trms,t ,alpha,beta,ntott,'tms ',ifverbose)
         do i = 2,ldimt
            call avg2 (trms(1,1,1,1,i),t(1,1,1,1,i),alpha,beta,
     &                 ntott,'psms',ifverbose)
         enddo

         ! compute averages E(X*Y) (for now just for the velocities)
         call avg3    (uvms,vx,t ,alpha,beta,ntot,'uvm ',ifverbose)
         call avg3    (vwms,vy,t ,alpha,beta,ntot,'vwm ',ifverbose)
         call avg3    (wums,vz,t ,alpha,beta,ntot,'wum ',ifverbose)
      endif
c
c-----------------------------------------------------------------------
      if ( (mod(istep,iastep).eq.0.and.istep.gt.1) .or.lastep.eq.1) then

         time_temp = time
         time      = atime   ! Output the duration of this avg

         call outpost (uavg,vavg,wavg,pavg,tavg,'avg')
         call outpost (urms,vrms,wrms,prms,trms,'rms')
         call outpost (uvms,vwms,wums,prms,trms,'rm2')

         atime = 0.
         time  = time_temp  ! Restore clock

      endif
c
      timel = time
c
      return
      end
c-----------------------------------------------------------------------
      subroutine set_volsource
      include 'SIZE'
      include 'TOTAL'

      common /cfluxa/  flux_area,gamma_t,cond_cu,prandtl,rhocp_s
      common /source/  volsource(lx1,ly1,lz1,lelt)
      common /scrvh/   h1(lx1,ly1,lz1,lelt),h2(lx1,ly1,lz1,lelt)

      integer e

      n  = lx1*ly1*lz1*nelt

      call rzero(h2,n)

      imesh  = 2  ! fluid + solid mesh
      ifield = 2  ! temperature
      isd    = 1  ! "x" direction (but doesn't really matter if 1,2, or 3)

      call axhelm(volsource,zm1,vdiff(1,1,1,1,2),h2,imesh,isd) ! FLOW IN Z direction!

      gamma_m = -gamma_t
      do i=1,n
         volsource(i,1,1,1) = (gamma_m*volsource(i,1,1,1))/bm1(i,1,1,1)
      enddo

      return
      end
c-----------------------------------------------------------------------
