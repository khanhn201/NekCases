c-----------------------------------------------------------------------
      subroutine chk_bdry(ifld,nel,bdryid,s3)
      implicit none
      include 'SIZE'
      include 'TSTEP' ! ifield
c      include 'TOTAL'

      integer ifld,nel,bdryid(2*ldim,lelt)
      character*3 s3

      real tmp(lx1,ly1,lz1,lelt)
      integer maxbdry, ibc, nbc, nbcface0, nbcface1
      integer  e, f, ix, iy, iz
      parameter(maxbdry=99)
      integer nbdrys(maxbdry),iwork(maxbdry)
      integer iglsum,iglmax

      integer ix_fctr(6), iy_fctr(6), iz_fctr(6), idd
      parameter(idd=ldim-1)
      data ix_fctr /  2,lx1,  2,  1,  2,  2/
      data iy_fctr /  1,  2,ly1,  2,  2,  2/
      data iz_fctr /idd,idd,idd,idd,  1,lz1/

      ifield=ifld

      call rone(tmp,lx1*ly1*lz1*lelt)
      call izero(nbdrys,maxbdry)
      call dssum(tmp,lx1,ly1,lz1)

      nbcface0 = 0
      nbcface1 = 0

      nbc = 0
      do e=1,nel
      do f=1,2*ldim

        ibc = bdryid(f,e)
        if (ibc.gt.0) then
          nbdrys(ibc) = nbdrys(ibc) + 1
          nbcface0 = nbcface0 + 1
          nbc = max(nbc,ibc)
        endif

        ix = ix_fctr(f)
        iy = iy_fctr(f)
        iz = iz_fctr(f)
        if (tmp(ix,iy,iz,e).lt.1.5) nbcface1 = nbcface1 + 1

      enddo
      enddo
      nbcface0 = iglsum(nbcface0,1)
      nbcface1 = iglsum(nbcface1,1)

      nbc = iglmax(nbc,1)
      call igop(nbdrys,iwork,'+  ',nbc)

      ! if any one of nbdrys(ibc) is zero, there is an error in connecivity or bc
      ! Also, nbcface0 shoud be the same as nbcface1
      if (nio.eq.0) then
        do ibc=1,nbc
          write(*,*)'chk bdryidt',s3,ibc,nbdrys(ibc)
        enddo
        write(*,*)'chk bdryidt',s3,' total',nbc,nbcface0,nbcface1
      endif

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'  
      include 'TOTAL' 
      include 'NEKNEK'

      real x0(3)
      save x0
      data x0 /3*0/
      
      integer bIDs(1), iobj_wall(1)
      
      call nekgsync
c     ifpsco(1)=.true.
c     ifto=.true.
      call lambda2(t(1,1,1,1,4)) ! Put lambda2 --> passive scalar 4
      
      n = lx1*ly1*lz1*nelt
c     call compute_cfl(cfl,vx,vy,vz,dt)
c     call copy(t, cflf, n)
c     do i=1,n
c       t(i,1,1,1,1)= log(t(i,1,1,1,1))
c     enddo
c     do e=1,nelt
c       rid = nid
c       call cfill(t(1,1,1,e,1),nid, )
c     enddo
      
      ! Turbine inner
      if (istep.eq.0) then
         bIDs(1) = 2
         call create_obj(iobj_wall(1),bIDs,1)
      endif
      call torque_calc(1.0,x0,.true.,.true.)

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer icalld
      save    icalld
      data    icalld  /0/

      n = nx1*ny1*nz1*nelv

      ie = gllel(ieg)
      ux=0.0
      uy=-1.0
      uz=0.0
      temp=0

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat0
      include 'SIZE'

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      include 'SIZE'
      include 'TOTAL'

      ifto = .true. ! required to lambda2
 
      return
      end
C=======================================================================
      subroutine usrdat2
      include 'SIZE'
      include 'TOTAL'


      parameter (lt=lx1*ly1*lz1*lelt)
      real mask
      integer partition_map
      common /mydiff/ xd(lx1,ly1,lz1,lelt),yd(lx1,ly1,lz1,lelt),
     $                zd(lx1,ly1,lz1,lelt),
     $                xd1(lx1,ly1,lz1,lelt),yd1(lx1,ly1,lz1,lelt),
     $                zd1(lx1,ly1,lz1,lelt),
     $                mask(lx1,ly1,lz1,lelt),
     $                partition_map(lx1,ly1,lz1,lelt)

      real foursplines(4,3,4)
      real fourlimits(4,2)
      real pc(3)

      integer e,eg,f
      real      zgmf(lx1),wxmf(lx1)


      integer max_surfs, n_surf, ss
      parameter(max_surfs=lelt*6) ! to be set to =lelt
      integer surf_face(3, max_surfs) ! (dest, elem, face)
      real surf_pack(58, max_surfs)


      n = lx1*ly1*lz1*nelt
      call domain_size(xmn,xmx,ymn,ymx,zmn,zmx)

      scale = 0.001
      scale = 1
      call cmult(xm1,scale,n)
      call cmult(ym1,scale,n)
      call cmult(zm1,scale,n)

      call rzero(xd,n)
      call rzero(yd,n)
      call rzero(zd,n)
      call rzero(xd1,n)
      call rzero(yd1,n)
      call rzero(zd1,n)

      call rone (mask,n)

      
      nface = 2*ldim

      rad_target = glamax(xm1,n)
      do e=1,nelv
        eg = lglel(e)
        do f=1,nface
              if (cbc(f,e,1).eq.'int') then ! On rim
                 call facind(i0,i1,j0,j1,k0,k1,lx1,ly1,lz1,f)
                 do k=k0,k1
                 do j=j0,j1
                 do i=i0,i1
                         mask(i,j,k,e) = 0.0
			 x = xm1(i,j,k,e)
			 y = ym1(i,j,k,e)
			 z = zm1(i,j,k,e)
			 rad_loc = sqrt(x*x + z*z)
			 xt = (rad_target/rad_loc)*x
			 zt = (rad_target/rad_loc)*z
			 xd1(i,j,k,e) = xt - xm1(i,j,k,e)
		         zd1(i,j,k,e) = zt - zm1(i,j,k,e)
                 enddo
                 enddo
                 enddo
              endif
        enddo
      enddo

      call read_surfaces(surf_face, surf_pack, n_surf)
      call zwgll(zgmf,wxmf,lx1)

      do ss=1,n_surf
        eg = surf_face(2,ss)
        f = surf_face(3,ss)
        call facind(i0,i1,j0,j1,k0,k1,lx1,ly1,lz1,f)
        do k=k0,k1
        do j=j0,j1
        do i=i0,i1
         e = gllel(eg)
         x = xm1(i,j,k,e)
         y = ym1(i,j,k,e)
         z = zm1(i,j,k,e)
         mask(i,j,k,e) = 0.0
         ! foursplines(4,3,4)
         ! fourlimits(4,2)
         do spline=1,4
         do dimen=1,3
           do sii=1,4
             foursplines(spline, dimen, sii) = 
     $         surf_pack(2 + (spline-1)*14 + (dimen-1)*4 + sii, ss)
           enddo
           fourlimits(spline, 1) =
     $       surf_pack(2 + spline*14 - 1, ss)
           fourlimits(spline, 2) =
     $       surf_pack(2 + spline*14, ss)
         enddo
         enddo
         v = (zgmf(k - k0 + 1)+1)/2
         u = 1 - (zgmf(i - i0 + 1)+1)/2

         if ((u.lt.-0.1).or.(u.gt.1.1)) then
           write(6,*) 'u', u
         endif
         if ((v.lt.-0.1).or.(v.gt.1.1)) then
           write(6,*) 'v', v
         endif
         call coons_patch(foursplines,fourlimits,u,v,pc,x,y,z)
         xd(i,j,k,e) = pc(1) - x
         yd(i,j,k,e) = pc(2) - y
         zd(i,j,k,e) = pc(3) - z
        enddo
        enddo
        enddo
      enddo
      call dsop(mask,'*  ',lx1,ly1,lz1)  ! zero mask for any surface vertex


      call projection_iter(xd1, yd1, zd1, mask) ! project outer cylinder
      call projection_iter(xd, yd, zd, mask) ! project blade


c     call exitti('quit usrdat2$',n)


      do iel=1,nelt
         do iface = 1, nface
            if (cbc(iface,iel,1) .eq. 'W  ') then
               cbc(iface,iel,1) = 'mv '
            endif
c           if (cbc(iface,iel,1) .eq. 's  ') then
c              cbc(iface,iel,1) = 'E  '
c           endif
c     If only testing inner blade
c           if (cbc(iface,iel,1) .eq. 'int') then
c              cbc(iface,iel,1) = 'v  '
c           endif
c     Else
            if (cbc(iface,iel,1) .eq. 'v  ') then
               cbc(iface,iel,1) = 'int'
            endif
            if (cbc(iface,iel,1) .eq. 'O  ') then
               cbc(iface,iel,1) = 'int'
            endif
         enddo 
      enddo

      do iel=1,nelt
      do ifc=1,2*ndim
         if (cbc(ifc,iel,1) .eq. 'int') then
           boundaryID(ifc,iel) = 1
         endif
         if (cbc(ifc,iel,1) .eq. 'mv ') then
           boundaryID(ifc,iel) = 2
         endif
      enddo
      enddo

      call chk_bdry(1,nelv,boundaryID,'vvv')

c     call rzero(partition_map,n)
c     do e=1,n
c        partition_map(e,1,1,1) = nid
c     enddo
c     call outpost(xd1,yd1,zd1,nid,nid,'nid')

      return
      end
c----------------------------------------------------------------------
      subroutine projection_iter(xd, yd, zd, mask)
      include 'SIZE'
      include 'TOTAL'


      parameter (lt=lx1*ly1*lz1*lelt)
      real xd(lx1,ly1,lz1,lelt),yd(lx1,ly1,lz1,lelt),
     $                zd(lx1,ly1,lz1,lelt),
     $                xd1(lx1,ly1,lz1,lelt),yd1(lx1,ly1,lz1,lelt),
     $                zd1(lx1,ly1,lz1,lelt),
     $                mask(lx1,ly1,lz1,lelt)
      real h1(lt),h2(lt),work(lt, mxprev)


      integer napprox(2)

      real dd1(lx1*ly1*lz1*lelv)
      real dd2(lx1*ly1*lz1*lelv)

      n = lx1*ly1*lz1*nelt
      call rone (h1,n)
      call rzero(h2,n)
      call izero(napprox,2)


c     corner displacement
      do k=1,n
        xd1(k,1,1,1) = min(xd(k,1,1,1), 0.0)
        yd1(k,1,1,1) = min(yd(k,1,1,1), 0.0)
        zd1(k,1,1,1) = min(zd(k,1,1,1), 0.0)
      enddo
      do k=1,n
        xd(k,1,1,1) = max(xd(k,1,1,1), 0.0)
        yd(k,1,1,1) = max(yd(k,1,1,1), 0.0)
        zd(k,1,1,1) = max(zd(k,1,1,1), 0.0)
      enddo

      call dsop(xd1,'min',lx1,ly1,lz1)
      call dsop(xd,'max',lx1,ly1,lz1)
      call dsop(yd1,'min',lx1,ly1,lz1)
      call dsop(yd,'max',lx1,ly1,lz1)
      call dsop(zd1,'min',lx1,ly1,lz1)
      call dsop(zd,'max',lx1,ly1,lz1)

      do k=1,n
        xd(k,1,1,1) = xd(k,1,1,1) + xd1(k,1,1,1)
        yd(k,1,1,1) = yd(k,1,1,1) + yd1(k,1,1,1)
        zd(k,1,1,1) = zd(k,1,1,1) + zd1(k,1,1,1)
      enddo

c     call outpost(xd,yd,zd,bm1,mask,'   ')
c     call add2(xm1,xd,n)
c     call add2(ym1,yd,n)
c     call add2(zm1,zd,n)
c     call outpost(xd,yd,zd,bm1,t,'   ')
c     call fix_geom !Reblend surface elements that have been projected

c     main laplace loop
      alpha = 0.02
      tol     = 1.e-7
      maxit   = 800
      factor = 0.1
      
      lapit = 0
      do k=1,lapit
        call cheap_dist(dd1,1,'mv ')
        call cheap_dist(dd2,1,'int')
        do j=1,lx1*ly1*lz1*nelv
           dd1(j) = min(dd1(j),dd2(j))
        enddo
        call cheap_dist(dd2,1,'SYM')
        do j=1,lx1*ly1*lz1*nelv
           dd1(j) = min(dd1(j),dd2(j))
        enddo
c       call cheap_dist(dd2,1,'s  ')
c       do j=1,lx1*ly1*lz1*nelv
c          dd1(j) = min(dd1(j),dd2(j))
c       enddo
        call cheap_dist(dd2,1,'W  ')
        do j=1,lx1*ly1*lz1*nelv
           dd1(j) = min(dd1(j),dd2(j))
        enddo
        call cheap_dist(dd2,1,'v  ')
        do j=1,lx1*ly1*lz1*nelv
           dd1(j) = min(dd1(j),dd2(j))
        enddo
        call cheap_dist(dd2,1,'O  ')
        do j=1,lx1*ly1*lz1*nelv
           dd1(j) = min(dd1(j),dd2(j))
        enddo

        do i=1,lx1*ly1*lz1*nelv
           h1(i) = 1+ 9*EXP(-dd1(i)/alpha)
        enddo
        if (k.eq.lapit) then
           factor = 1
        endif
        factor = 1.0/lapit
        do j=1,lx1*ly1*lz1*nelv
           xd1(j,1,1,1) = xd(j,1,1,1)*factor
           yd1(j,1,1,1) = yd(j,1,1,1)*factor
           zd1(j,1,1,1) = zd(j,1,1,1)*factor
        enddo
        call laplaceh('dspx',xd1,h1,h2,mask,vmult,1
     $                ,tol,maxit,work,napprox)
        call laplaceh('dspy',yd1,h1,h2,mask,vmult,1
     $                ,tol,maxit,work,napprox)
        call laplaceh('dspz',zd1,h1,h2,mask,vmult,1
     $                ,tol,maxit,work,napprox)


c       call outpost(xd1,yd1,zd1,bm1,h1,'   ')
        call add2(xm1,xd1,n)
        call add2(ym1,yd1,n)
        call add2(zm1,zd1,n)
c       call outpost(xd1,yd1,zd1,bm1,h1,'   ')
        call fix_geom !Reblend surface elements that have been projected
        if (nio.eq.0) write(6,*) 'Done project ', k, '/', lapit
      end do

      end
c----------------------------------------------------------------------
      subroutine read_surfaces(surf_face, surf_pack, n_surf)
      implicit none
      include 'SIZE'
      include 'PARALLEL'

      integer nidd,npp,nekcomm,nekgroup
      real nekreal
      common /nekmpi/ nidd,npp,nekcomm,nekgroup,nekreal

      integer max_surfs
      parameter(max_surfs=lelt*6) ! to be set to =lelt

      integer file_size, block_size, num_blocks, skip_bytes, p
      integer cr_surf, i, n_surf, mtag, num_surfs, j, elem, k
      
      integer surf_face(3, max_surfs) ! (dest, elem, face)
      real surf_pack(58, max_surfs)
      real empty_surf_pack(58, max_surfs)
      character header(92)
      character buf(58*8)
      real*8 temp

c     header
c       80 bytes strings
c       4 bytes 6.54321 endian check
c       8 bytes n_surfaces
c     58 doubles for each surface
c       elem_id
c       face
c       spline1 12 coeffs
c               2 endpoints
c       spline2 12 coeffs
c               2 endpoints
c       spline3 12 coeffs
c               2 endpoints
c       spline4 12 coeffs
c               2 endpoints


      call rzero(empty_surf_pack, 58*max_surfs)
      call rzero(surf_pack, 58*max_surfs)
      call rzero(surf_face, 3*max_surfs)
      mtag = 999

      block_size = 58*8 ! 58 doubles/surface
      skip_bytes = 92 ! skip header
      call nekgsync()

      if (nid.eq.0) then
         open(unit=10, file='inner.ssurf', form='unformatted', 
     $           access='stream', action='read')
         inquire(unit=10, size=file_size)
         num_surfs = (file_size - skip_bytes) / block_size
c      CHECK FOR ENDIAN?
         read(10) header
         write(6,*) header
         write(6,*) 'Number of surfaces', file_size - skip_bytes,
     $    num_surfs
         k = 0
         p = 1
         do i = 1, num_surfs
           read(10) buf
           k = k + 1
           do j = 1,58
             temp = transfer(buf((j-1)*8+1:j*8), temp)
             surf_pack(j, k) = temp
           end do
           if (k.eq.(max_surfs)) then
               call csend(mtag,surf_pack,max_surfs*block_size,p,0)
               p = p + 1
               k = 0
               call rzero(surf_pack, 58*max_surfs)
           endif
         end do
         do i = p, np-1
           call csend(mtag,empty_surf_pack,max_surfs*block_size,i,0)
         end do
         close(10)
c     write(6,*) 'nid, id_start, id_end', nid, surf_pack(1,1)
c    $                                       , surf_pack(1,max(k,1))
      else
         call crecv(mtag,surf_pack,max_surfs*block_size)
c     write(6,*) 'nid, id_start, id_end', nid, surf_pack(1,1)
c    $                                       , surf_pack(1,max_surfs)
      endif
      
      call nekgsync()
c     process packs
      n_surf = 0
      do i = 1, max_surfs
        if (surf_pack(1,i).eq.0.0) then
            exit
        endif
        elem = int(surf_pack(1,i))
        surf_face(1, i) = gllnid(elem)
        surf_face(2, i) = elem
        surf_face(3, i) = int(surf_pack(2,i))
        n_surf = n_surf + 1
      end do
      write(6,*) 'nid, id_start, id_end', nid, surf_face(2,1)
     $                 , surf_face(2,max(n_surf,1)), n_surf

      call nekgsync()
      call fgslib_crystal_setup(cr_surf,nekcomm,np)
      call fgslib_crystal_tuple_transfer(cr_surf,n_surf,max_surfs
     $                          ,surf_face,3,0,0,surf_pack,58,1)
      call fgslib_crystal_free(cr_surf)
      write(6,*) nid, "recieved", n_surf
      call nekgsync()

      return
      end

c----------------------------------------------------------------------
      subroutine coons_patch(foursplines, fourlimits, u, v, p, x,y,z)

      implicit none
      real foursplines(4,3,4)
      real fourlimits(4,2)
      real u, v, p(3)
      real x,y,z
      real u_min, u_max, v_min, v_max
      real Cu(3), Cv(3), B(3)
      real eval_spline
      integer i
      
      do i = 1, 3
         Cu(i) = eval_spline(foursplines(1,i,:), u, 
     $                fourlimits(1,1), fourlimits(1,2)) * (1-v) +
     $           eval_spline(foursplines(3,i,:), u,
     $                fourlimits(3,1), fourlimits(3,2)) * v
         Cv(i) = eval_spline(foursplines(2,i,:), v, 
     $                fourlimits(2,1), fourlimits(2,2)) * u +
     $           eval_spline(foursplines(4,i,:), v,
     $                fourlimits(4,1), fourlimits(4,2)) * (1-u)
      end do
      
      p(1) = Cu(1) + Cv(1) - x
      p(2) = Cu(2) + Cv(2) - y
      p(3) = Cu(3) + Cv(3) - z
      
      return
      end
c----------------------------------------------------------------------
      function eval_spline(coeffs, t, t_min, t_max)
      implicit none
      real coeffs(4), t, t_min, t_max, eval_spline
      real dt, s
      
      dt = t_max - t_min
      s = t*dt
      eval_spline = coeffs(1) * s**3 + coeffs(2) * s**2 +
     &              coeffs(3) * s + coeffs(4)
      return
      end
c-----------------------------------------------------------------------
      subroutine laplaceh(name,u,h1,h2,mask,mult,ifld
     $                   ,tli,maxi,approx,napprox)
      include 'SIZE'
      include 'TOTAL'
      include 'CTIMER'


      common  /cprint/ ifprint, ifhzpc
      logical          ifprint, ifhzpc

      character*4 name
      real u(1),h1(1),h2(1),mask(1),mult(1),approx (1)
      integer   napprox(1)

      parameter (lt=lx1*ly1*lz1*lelt)
      common /scruz/ r (lt),ub(lt)

      logical ifstdh
      character*4  cname
      character*6  name6

      logical ifwt,ifvec

      call chcopy(cname,name,4)
      call capit (cname,4)

      call blank (name6,6)
      call chcopy(name6,name,4)
      ifwt  = .true.
      ifvec = .false.
      isd   = 1
      imsh  = 1
      nel   = nelfld(ifld)

      n = nx1*ny1*nz1*nel

      call copy (ub,u,n)             ! ub = u on boundary
      call dsavg(ub)                 ! Make certain ub is in H1
                                     !     _
      call axhelm (r,ub,h1,h2,1,1)   ! r = A*ub

      do i=1,n                       !        _
         r(i)=-r(i)*mask(i)          ! r = -M*A*ub
      enddo

      call dssum  (r,nx1,ny1,nz1)    ! dssum rhs

      call project1
     $     (r,n,approx,napprox,h1,h2,mask,mult,ifwt,ifvec,name6)


      ifprint = .false.               ! Make Helmholtz
      param(74) = 1                  ! verbose

      tol = abs(tli)
      p22=param(22)
      param(22)=abs(tol)
      if (nio.eq.0) write(6,*) 'Calling hmhzpf ',name
      if (nel.eq.nelv) then
        call hmhzpf (name,u,r,h1,h2,mask,mult,imsh,tol,maxi,isd,binvm1)
      else
        call hmhzpf (name,u,r,h1,h2,mask,mult,imsh,tol,maxi,isd,bintm1)
      endif
      param(22)=p22

      call project2
     $     (u,n,approx,napprox,h1,h2,mask,mult,ifwt,ifvec,name6)

      call add2(u,ub,n)

      return
      end
