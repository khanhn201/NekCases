c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'


      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat0

      include 'SIZE'
      include 'TOTAL'

      common /casevars/ p_gamma_r, p_gamma_i, p_alpha, p_eps
      real p_gamma_r, p_gamma_i, p_alpha, p_eps

      call nekrs_registerPtr('p_gamma_r', P_GAMMA_R)
      call nekrs_registerPtr('p_gamma_i', P_GAMMA_I)
      call nekrs_registerPtr('p_alpha', P_ALPHA)
      call nekrs_registerPtr('p_eps', P_EPS)

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'TOTAL'

      common /initu/   ub(lx1,ly1,lz1,lelv),vb(lx1,ly1,lz1,lelv),
     $                 wb(lx1,ly1,lz1,lelv)
      real ub, vb, wb

      ntot = lx1*ly1*lz1*nelv

      ! Initialize with IC
      call gen_pert_ic
      call copy(vx(1,1,1,1),ub(1,1,1,1),ntot)
      call copy(vy(1,1,1,1),vb(1,1,1,1),ntot)
      call copy(vz(1,1,1,1),wb(1,1,1,1),ntot)

      return
      end

cc-----------------------------------------------------------------------
      subroutine usrdat   ! This routine to modify element vertices
      include 'SIZE'      ! _before_ mesh is generated, which 
      include 'TOTAL'     ! guarantees GLL mapping of mesh.

      return
      end

c-----------------------------------------------------------------------
      subroutine usrdat2()  ! This routine to modify mesh coordinates                                      
      include 'SIZE'
      include 'TOTAL'

      common /casevars/ p_gamma_r, p_gamma_i, p_alpha, p_eps
      real p_gamma_r, p_gamma_i, p_alpha, p_eps

      real zlength

      zlength = 2*pi/p_alpha
      call rescale_x (zm1,0.0,zlength)

      ! reconstruct boundary tags 
      do iel=1,nelv
        do ifc=1,2*ndim
           if (cbc(ifc,iel,1) .eq. 'W  ') boundaryID(ifc,iel) = 1
        enddo
        enddo
  
        do iel=1,nelt
        do ifc=1,2*ndim
           if (cbc(ifc,iel,2) .eq. 'I  ') boundaryIDt(ifc,iel) = 1
        enddo
        enddo
    
      return
      end
cc-----------------------------------------------------------------------
      subroutine usrdat3
      include 'SIZE'
      include 'TOTAL'

      return
      end
c----------------------------------------------------------------------- 
      subroutine gen_pert_ic ! perturbation i.c.s
      include 'SIZE'
      include 'TOTAL'

      common /peru/ ur(lx1,ly1,lz1,lelv)  , ui(lx1,ly1,lz1,lelv)  ,
     $               vr(lx1,ly1,lz1,lelv)  , vi(lx1,ly1,lz1,lelv)  ,
     $               wr(lx1,ly1,lz1,lelv)  , wi(lx1,ly1,lz1,lelv)
      real ur, ui, vr, vi, wr, wi

      common /initu/   ub(lx1,ly1,lz1,lelv),vb(lx1,ly1,lz1,lelv),
     $                 wb(lx1,ly1,lz1,lelv)
      real ub, vb, wb

      common /baseu/   ubase(lx1,ly1,lz1,lelv)
      real ubase

      integer e,eg,ex,ey,ez,nelxy,nelz,m,i,j,k,n
      real x, y, z, c, s

      common /casevars/ p_gamma_r, p_gamma_i, p_alpha, p_eps
      real p_gamma_r, p_gamma_i, p_alpha, p_eps

      real epsamp

      integer icalld
      save    icalld
      data    icalld  /0/


      n = nx1*ny1*nz1*nelv

      if (icalld.eq.0) then
         icalld = 1
         call gfldr("u_base0.f00001")
         call copy(ubase(1,1,1,1),vz(1,1,1,1),n)
         call gfldr("u_real0.f00001")
         call copy(ur(1,1,1,1),vx(1,1,1,1),n)
         call copy(vr(1,1,1,1),vy(1,1,1,1),n)
         call copy(wr(1,1,1,1),vz(1,1,1,1),n)
         call gfldr("u_imag0.f00001")
         call copy(ui(1,1,1,1),vx(1,1,1,1),n)
         call copy(vi(1,1,1,1),vy(1,1,1,1),n)
         call copy(wi(1,1,1,1),vz(1,1,1,1),n)
      endif

      epsamp = p_eps*exp(p_gamma_r*time)

      do e=1,nelv
      do k=1,nz1
      do j=1,ny1
      do i=1,nx1
         x  = xm1(i,j,k,e)
         y  = ym1(i,j,k,e)
         z  = zm1(i,j,k,e)
         az = p_alpha*z + p_gamma_i*time

         c  = cos(az)
         s  = sin(az)

         ub(i,j,k,e) = epsamp*(ur(i,j,k,e)*c - ui(i,j,k,e)*s)
         vb(i,j,k,e) = epsamp*(vr(i,j,k,e)*c - vi(i,j,k,e)*s)
         wb(i,j,k,e) = epsamp*(wr(i,j,k,e)*c - wi(i,j,k,e)*s)
         wb(i,j,k,e) = wb(i,j,k,e) + ubase(i,j,k,e)
      enddo
      enddo
      enddo
      enddo

      return
      end
c---------------------------------------------------------------------
